@page "/not-found"
@layout MainLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<PageTitle>404 — Page Not Found | Chronon</PageTitle>

<div class="min-h-[70vh] flex flex-col items-center justify-center p-4 sm:p-6 w-full max-w-lg mx-auto my-auto font-sans">
    <div class="w-full bg-card border-[3px] border-border shadow-neo-xl rounded-xl p-8 sm:p-10 text-center transition-all duration-200"
         role="region"
         aria-labelledby="not-found-heading">

        <!-- Bold 404 Geometric Display (A11y: Hidden from screen reader text flow) -->
        <div class="select-none" aria-hidden="true">
            <p class="font-mono text-7xl sm:text-8xl font-black leading-none tracking-tighter text-foreground">
                404
            </p>
        </div>

        <!-- Neobrutalist Accent Bar -->
        <div class="mx-auto mt-4 mb-6 h-1.5 w-24 bg-[#A6FA53] border-2 border-border shadow-neo-sm rounded-full"
             aria-hidden="true"></div>

        <!-- Accessible Headline -->
        <h1 id="not-found-heading" class="text-2xl sm:text-3xl font-extrabold leading-tight text-foreground tracking-tight">
            Page Not Found
        </h1>

        <!-- Empathetic, Non-Technical User Copy -->
        <p class="mt-3 text-sm sm:text-[15px] font-medium leading-[22px] text-muted-foreground max-w-sm mx-auto">
            The page you are looking for does not exist, has been moved, or is temporarily unavailable.
        </p>

        <!-- Actions (Strict Separation of Primary vs Secondary Hierarchy) -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <!-- Primary Action Trigger -->
            <a href="@HomeDestination"
               class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] bg-[#A6FA53] text-black font-bold text-[15px] border-2 border-border shadow-neo rounded-lg hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 transition-all motion-reduce:transform-none motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A6FA53] focus-visible:ring-offset-2 w-full sm:w-auto cursor-pointer">
                <!-- Home Icon SVG -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                @HomeLabel
            </a>

            <!-- Secondary Action Trigger -->
            <button type="button"
                    @onclick="GoBack"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] bg-card text-foreground font-bold text-[15px] border-2 border-border shadow-neo rounded-lg hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 transition-all motion-reduce:transform-none motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A6FA53] focus-visible:ring-offset-2 w-full sm:w-auto cursor-pointer">
                <!-- Arrow Left SVG -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m12 19-7-7 7-7"/>
                    <path d="M19 12H5"/>
                </svg>
                Go Back
            </button>
        </div>
    </div>

    <!-- Subtitle / Footer Note -->
    <p class="mt-6 text-center font-mono text-xs font-bold tracking-wider uppercase text-muted-foreground select-none">
        Chronon Attendance Tracker
    </p>
</div>

@code {
    private string HomeDestination => AuthState.IsLoggedIn ? "dashboard" : "";
    private string HomeLabel => AuthState.IsLoggedIn ? "Return to Dashboard" : "Back to Home";

    private async Task GoBack()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch
        {
            Navigation.NavigateTo(HomeDestination);
        }
    }
}