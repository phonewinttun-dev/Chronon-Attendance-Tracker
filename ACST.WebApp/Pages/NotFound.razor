@page "/not-found"
@layout MainLayout

<PageTitle>Not Found</PageTitle>

<div class="min-h-[60vh] flex flex-col items-center justify-center p-8 text-center bg-card border-2 border-black dark:border-zinc-700 rounded-2xl shadow-neo-xl max-w-lg mx-auto my-12 font-mono">
    <div class="w-20 h-20 rounded-2xl bg-[#FF6B6B] text-black border-2 border-black flex items-center justify-center mb-6 shadow-neo text-3xl font-black">
        404
    </div>
    <h1 class="text-3xl font-black tracking-tight text-foreground font-sans mb-2">Page Not Found</h1>
    <p class="text-xs text-muted-foreground max-w-sm mb-6 leading-relaxed">
        The page or resource you are looking for does not exist or has been relocated.
    </p>
    <a href="dashboard" class="neo-btn-primary px-5 py-2.5 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider">
        Return to Dashboard
    </a>
</div>