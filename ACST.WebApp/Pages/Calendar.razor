@page "/calendar"
@using ACST.WebApp.Models
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation


<PageTitle>Calendar</PageTitle>

<!-- Header Row -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-foreground font-sans">Schedule Calendar</h1>
        <p class="text-xs text-muted-foreground font-mono mt-1">View monthly schedules, class sessions, and holidays.</p>
    </div>
</div>

<!-- Controls Panel -->
<div class="bg-card border-2 border-black dark:border-zinc-700 p-4 rounded-xl shadow-neo mb-6 flex flex-wrap justify-between items-center gap-4 font-mono">
    <!-- Month Navigation -->
    <div class="flex items-center gap-3">
        <button class="neo-btn bg-card hover:bg-muted text-foreground p-2 border-2 border-border rounded-lg shadow-neo-sm transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A6FA53]" 
                aria-label="Previous month"
                @onclick="PrevMonth">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <span class="text-base font-black font-mono text-foreground min-w-[160px] text-center" aria-live="polite">@_viewDate.ToString("MMMM yyyy")</span>
        <button class="neo-btn bg-card hover:bg-muted text-foreground p-2 border-2 border-border rounded-lg shadow-neo-sm transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A6FA53]" 
                aria-label="Next month"
                @onclick="NextMonth">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
        </button>
        
        <button class="neo-btn bg-card hover:bg-muted text-foreground px-4 py-2 border-2 border-border rounded-lg shadow-neo-sm text-xs font-bold transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A6FA53]" 
                aria-label="Jump to current month"
                @onclick="GoToToday">
            Today
        </button>
    </div>

    <!-- Filters -->
    <div class="flex items-center gap-3">
        <CustomSelect TValue="long"
                      Value="_selectedSemesterId"
                      ValueChanged="OnSemesterChanged"
                      Placeholder="All Semesters"
                      Class="min-w-[200px]">
            <CustomSelectOption TValue="long" Value="0L" Text="All Semesters" />
            @if (_semesters != null)
            {
                @foreach (var sem in _semesters)
                {
                    <CustomSelectOption TValue="long" Value="@sem.Id" Text="@sem.Name" />
                }
            }
        </CustomSelect>
    </div>
</div>

<!-- Message Notification -->
@if (!string.IsNullOrEmpty(_message))
{
    <div class="border-2 border-black shadow-neo-sm p-4 rounded-xl mb-6 text-xs font-mono font-bold flex items-center justify-between gap-3 transition-all @(_isError ? "bg-[#FF6B6B]/20 text-[#FF6B6B]" : "bg-[#A6FA53]/20 text-[#A6FA53]")">
        <div class="flex items-center gap-2.5">
            @if (_isError)
            {
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
            }
            <span>@_message</span>
        </div>
        <button class="hover:opacity-80 focus:outline-none text-base font-black px-1.5 py-0.5 rounded cursor-pointer" @onclick="() => _message = string.Empty" title="Dismiss">×</button>
    </div>
}

<!-- Calendar Container -->
<div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo-lg overflow-hidden flex flex-col font-mono">
    <!-- Days of Week Header -->
    <div class="grid grid-cols-7 border-b-2 border-black dark:border-zinc-700 bg-muted/40 text-center font-bold text-xs text-foreground uppercase tracking-wider">
        <div class="py-2.5 border-r-2 border-border">Sun</div>
        <div class="py-2.5 border-r-2 border-border">Mon</div>
        <div class="py-2.5 border-r-2 border-border">Tue</div>
        <div class="py-2.5 border-r-2 border-border">Wed</div>
        <div class="py-2.5 border-r-2 border-border">Thu</div>
        <div class="py-2.5 border-r-2 border-border">Fri</div>
        <div class="py-2.5">Sat</div>
    </div>

    <!-- Calendar Grid -->
    @if (_isLoading)
    {
        <div class="grid grid-cols-7 auto-rows-fr divide-y-2 divide-x-2 divide-border border-b-2 border-border animate-pulse bg-card">
            @for (int i = 0; i < 42; i++)
            {
                <div class="h-[140px] p-2 flex flex-col bg-card">
                    <div class="flex justify-between items-center mb-2">
                        <div class="h-3 bg-muted rounded w-3"></div>
                        <div class="h-5 bg-muted rounded-full w-5"></div>
                    </div>
                    <div class="flex-1 flex flex-col gap-1.5 mt-1">
                        @if (i % 3 == 0)
                        {
                            <div class="h-8 bg-muted rounded w-full"></div>
                        }
                        else if (i % 5 == 0)
                        {
                            <div class="h-8 bg-muted rounded w-full"></div>
                            <div class="h-8 bg-muted rounded w-full"></div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-7 auto-rows-fr divide-y-2 divide-x-2 divide-border border-b-2 border-border">
            @foreach (var day in _calendarDays)
            {
                var isCurrentMonth = day.Month == _viewDate.Month;
                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                var daySessions = GetSessionsForDay(day);
                var dayHolidays = GetHolidaysForDay(day);

                <div class="h-[140px] p-2 flex flex-col bg-card hover:bg-muted/30 transition-colors
                            @(isCurrentMonth ? "" : "bg-muted/20 opacity-50")">
                    <!-- Day Indicator Header -->
                    <div class="flex justify-between items-center mb-1">
                        <div>
                            @if (dayHolidays.Any())
                            {
                                <span class="w-2 h-2 rounded-full bg-[#FFD026] border border-black inline-block" title="Holiday today"></span>
                            }
                        </div>
                        <span class="font-mono text-xs font-bold rounded-md w-6 h-6 inline-flex items-center justify-center
                                     @(isToday ? "bg-[#FFD026] text-black font-black border border-black shadow-neo-sm" : "text-muted-foreground")">
                            @day.Day
                        </span>
                    </div>

                    <!-- Holidays Box -->
                    @foreach (var hol in dayHolidays)
                    {
                        <div class="mt-1 px-1.5 py-0.5 text-[9px] font-bold text-black bg-[#FFD026] border border-black rounded shadow-neo-sm truncate font-mono" title="Holiday: @hol.Name">
                            @hol.Name
                        </div>
                    }
                    
                    <!-- Sessions List -->
                    <div class="flex-1 flex flex-col gap-1 mt-1 pr-0.5 overflow-y-auto [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-thumb]:bg-border [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-track]:bg-transparent">
                        @foreach (var session in daySessions)
                        {
                            <button type="button" 
                                    class="w-full flex items-center gap-1.5 py-1 px-1.5 border-2 rounded-md text-left transition-all shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 cursor-pointer focus:outline-none @GetSessionStyleClass(session.Status)"
                                    @onclick="() => OpenSessionDetails(session)"
                                    title="@session.ModuleCode (@FormatTime(session.StartDatetime) - @FormatTime(session.EndDatetime))">
                                <span class="w-2 h-2 rounded-full shrink-0 @GetDotColorClass(session.Status)"></span>
                                <span class="text-[9px] font-mono shrink-0 font-bold opacity-80">@FormatGoogleCalendarTime(session.StartDatetime)</span>
                                <span class="font-bold text-[10px] font-sans truncate">@session.ModuleCode</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Attendance/Status Update Modal -->
@if (_showDetailsModal && _selectedSession != null)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-50 animate-in fade-in duration-200" @onclick="CloseDetailsModal">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 max-w-sm w-full shadow-neo-xl animate-in zoom-in duration-200 font-mono" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="flex justify-between items-start border-b-2 border-border pb-3 mb-4">
                <div>
                    <h3 class="text-lg font-black text-foreground font-sans">Update Session</h3>
                    <p class="text-xs text-muted-foreground font-mono mt-0.5">Date: @_selectedSession.SessionDate.ToString("dd-MM-yyyy")</p>
                </div>
                <button type="button" class="text-muted-foreground hover:text-foreground font-black text-xl cursor-pointer" @onclick="CloseDetailsModal">×</button>
            </div>

            <!-- Session Info -->
            <div class="mb-5 bg-muted/30 border-2 border-border p-4 rounded-xl">
                <div class="text-xs font-bold text-muted-foreground uppercase">Module</div>
                <div class="text-sm font-black text-foreground font-sans mb-3">@_selectedSession.ModuleName (@_selectedSession.ModuleCode)</div>
                
                <div class="text-xs font-bold text-muted-foreground uppercase">Scheduled Time</div>
                <div class="text-xs font-mono font-bold text-foreground">
                    @FormatTime(_selectedSession.StartDatetime) - @FormatTime(_selectedSession.EndDatetime)
                </div>
                
                <div class="mt-3 flex items-center gap-2">
                    <span class="text-xs font-bold text-muted-foreground uppercase">Status:</span>
                    <span class="@GetBadgeClass(_selectedSession.Status)">@_selectedSession.Status</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col gap-2 font-mono">
                @if (true)
                {
                    <button class="neo-btn bg-[#A6FA53] text-black font-black py-2 px-4 rounded-xl text-xs shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all cursor-pointer" 
                            @onclick='() => RequestUpdateSessionStatus("Present")' disabled="@_isUpdating">
                        Mark Present
                    </button>
                    <button class="neo-btn bg-[#FF6B6B] text-black font-black py-2 px-4 rounded-xl text-xs shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all cursor-pointer" 
                            @onclick='() => RequestUpdateSessionStatus("Absent")' disabled="@_isUpdating">
                        Mark Absent
                    </button>
                    <button class="neo-btn bg-[#FFD026] text-black font-black py-2 px-4 rounded-xl text-xs shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all cursor-pointer" 
                            @onclick='() => RequestUpdateSessionStatus("Cancelled")' disabled="@_isUpdating">
                        Mark Cancelled
                    </button>
                    <button class="neo-btn bg-card text-foreground border-2 border-border py-2 px-4 rounded-xl text-xs font-bold shadow-neo-sm hover:bg-muted transition-all cursor-pointer" 
                            @onclick='() => RequestUpdateSessionStatus("Not Marked")' disabled="@_isUpdating">
                        Reset to Not Marked
                    </button>
                }
            </div>
        </div>
    </div>
}



@if (_showErrorDialog)
{
    <div class="fixed inset-0 bg-background/80 backdrop-blur-sm flex items-center justify-center z-[100] animate-in fade-in duration-200">
        <div class="bg-card border border-border rounded-lg p-6 max-w-sm w-full shadow-lg text-center animate-in zoom-in duration-200">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-destructive/10 text-destructive mb-4">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-foreground mb-2">Error</h3>
            <p class="text-xs text-muted-foreground mb-5 font-sans">Unexpected Error Ocurred. Please try again</p>
            <button class="w-full py-2 bg-primary text-primary-foreground hover:bg-primary/95 rounded-md text-xs font-semibold transition-colors focus:outline-none"
                    @onclick="() => { _showErrorDialog = false; }">
                Close
            </button>
        </div>
    </div>
}

@if (_showStatusConfirmModal)
{
    <div class="fixed inset-0 bg-background/80 backdrop-blur-sm flex items-center justify-center z-[150] animate-in fade-in duration-200">
        <div class="bg-card border border-border rounded-lg p-6 max-w-sm w-full shadow-lg animate-in zoom-in duration-200">
            <h3 class="text-base font-bold text-foreground mb-2">Confirm Status Change</h3>
            <p class="text-xs text-muted-foreground mb-6">
                Are you sure you want to change the status of this class session to <span class="font-bold text-foreground">@_confirmStatus</span>?
            </p>
            <div class="flex justify-end gap-3">
                <button type="button" 
                        class="px-4 py-2 bg-muted hover:bg-muted/80 text-foreground border border-border rounded-md text-xs font-semibold transition-all focus:outline-none" 
                        @onclick="CancelStatusChange">
                    Cancel
                </button>
                <button type="button" 
                        class="px-4 py-2 bg-primary hover:bg-primary/90 text-primary-foreground rounded-md text-xs font-semibold transition-all focus:outline-none" 
                        @onclick="ConfirmStatusChange">
                    Yes, Change
                </button>
            </div>
        </div>
    </div>
}

@if (_isUpdating)
{
    <div class="fixed inset-0 bg-background/80 backdrop-blur-sm flex flex-col items-center justify-center z-[200] animate-in fade-in duration-200">
        <div class="bg-card border border-border rounded-lg p-6 flex flex-col items-center gap-4 shadow-xl max-w-xs text-center animate-in zoom-in duration-200">
            <div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
            <div>
                <h4 class="text-sm font-bold text-foreground">Updating Attendance</h4>
                <p class="text-xs text-muted-foreground mt-1">Please wait while we update the session status...</p>
            </div>
        </div>
    </div>
}

@if (_showAlertModal)
{
    <div class="fixed inset-0 bg-background/80 backdrop-blur-sm flex items-center justify-center z-[200] animate-in fade-in duration-200">
        <div class="bg-card border border-border rounded-lg p-6 max-w-sm w-full shadow-lg text-center animate-in zoom-in duration-200">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-primary/10 text-primary mb-4">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-foreground mb-2">@_alertTitle</h3>
            <p class="text-sm text-muted-foreground mb-5 font-sans">@_alertMessage</p>
            <button class="w-full py-2 bg-primary text-primary-foreground hover:bg-primary/95 rounded-md text-xs font-semibold transition-colors focus:outline-none"
                    @onclick="() => { _showAlertModal = false; }">
                OK
            </button>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isUpdating = false;
    private string _message = string.Empty;
    private bool _isError = false;
    private bool _showErrorDialog = false;
    private bool _showStatusConfirmModal = false;
    private string _confirmStatus = string.Empty;
    private bool _showAlertModal = false;
    private string _alertMessage = string.Empty;
    private string _alertTitle = "Already Marked";

    private DateOnly _viewDate = DateOnly.FromDateTime(DateTime.Today);
    private List<DateOnly> _calendarDays = new();
    
    private List<SemesterDto>? _semesters;
    private long _selectedSemesterId = 0;

    private List<ClassSessionDto> _sessions = new();
    private List<HolidayDto> _holidays = new();

    // Modal state
    private bool _showDetailsModal = false;
    private ClassSessionDto? _selectedSession;

    private static readonly TimeSpan MyanmarOffset = TimeSpan.FromHours(6.5);

    protected override async Task OnInitializedAsync()
    {
        await LoadSemesters();
        SelectCurrentSemester();
        UpdateCalendarGrid();
        await LoadCalendarData();
    }

    private void SelectCurrentSemester()
    {
        if (_semesters == null || !_semesters.Any())
        {
            _selectedSemesterId = 0;
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var currentSem = _semesters.FirstOrDefault(s => today >= s.StartDate && today <= s.EndDate);
        
        if (currentSem != null)
        {
            _selectedSemesterId = currentSem.Id;
        }
        else
        {
            _selectedSemesterId = 0;
        }
    }

    private void UpdateCalendarGrid()
    {
        _calendarDays.Clear();
        var firstDayOfMonth = new DateOnly(_viewDate.Year, _viewDate.Month, 1);
        
        // Find Sunday of the starting week.
        int offset = (int)firstDayOfMonth.DayOfWeek;
        var startDate = firstDayOfMonth.AddDays(-offset);

        for (int i = 0; i < 42; i++)
        {
            _calendarDays.Add(startDate.AddDays(i));
        }
    }

    private async Task LoadSemesters()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<SemesterDto>>("api/semesters");
            if (result != null && result.IsSuccess)
            {
                _semesters = result.Data;
            }
        }
        catch
        {
            // Fail silently or fallback
        }
    }

    private async Task LoadCalendarData()
    {
        _isLoading = true;
        _message = string.Empty;
        try
        {
            // Load holidays if not loaded yet
            if (_holidays == null || !_holidays.Any())
            {
                var holResult = await Http.GetFromJsonAsync<PagedResult<HolidayDto>>("api/holidays");
                if (holResult != null && holResult.IsSuccess)
                {
                    _holidays = holResult.Data ?? new();
                }
            }

            // Load sessions only for the current month
            var startOfMonth = new DateOnly(_viewDate.Year, _viewDate.Month, 1);
            var endOfMonth = new DateOnly(_viewDate.Year, _viewDate.Month, DateTime.DaysInMonth(_viewDate.Year, _viewDate.Month));
            var startStr = startOfMonth.ToString("yyyy-MM-dd");
            var endStr = endOfMonth.ToString("yyyy-MM-dd");
            
            string url = $"api/classsessions?startDate={startStr}&endDate={endStr}&pageSize=1000";
            if (_selectedSemesterId > 0)
            {
                url += $"&semesterId={_selectedSemesterId}";
            }

            var sessResult = await Http.GetFromJsonAsync<PagedResult<ClassSessionDto>>(url);
            if (sessResult != null && sessResult.IsSuccess)
            {
                _sessions = sessResult.Data ?? new();
            }
        }
        catch (Exception)
        {
            _message = "Unexpected Error Ocurred. Please try again";
            _isError = true;
            _showErrorDialog = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSemesterChanged(long semesterId)
    {
        _selectedSemesterId = semesterId;
        
        // If they selected a specific semester, auto-navigate calendar to start date of semester
        if (semesterId > 0 && _semesters != null)
        {
            var selectedSem = _semesters.FirstOrDefault(s => s.Id == semesterId);
            if (selectedSem != null)
            {
                _viewDate = new DateOnly(selectedSem.StartDate.Year, selectedSem.StartDate.Month, 1);
                UpdateCalendarGrid();
            }
        }

        await LoadCalendarData();
    }

    private async Task PrevMonth()
    {
        _viewDate = _viewDate.AddMonths(-1);
        UpdateCalendarGrid();
        await LoadCalendarData();
    }

    private async Task NextMonth()
    {
        _viewDate = _viewDate.AddMonths(1);
        UpdateCalendarGrid();
        await LoadCalendarData();
    }

    private async Task GoToToday()
    {
        _viewDate = DateOnly.FromDateTime(DateTime.Today);
        UpdateCalendarGrid();
        await LoadCalendarData();
    }

    private List<ClassSessionDto> GetSessionsForDay(DateOnly date)
    {
        return _sessions.Where(s => s.SessionDate == date).ToList();
    }

    private List<HolidayDto> GetHolidaysForDay(DateOnly date)
    {
        return _holidays.Where(h => h.HolidayDate == date).ToList();
    }

    private string FormatTime(DateTime utcTime)
    {
        // Convert UTC datetime to local Myanmar offset
        var localTime = utcTime + MyanmarOffset;
        return localTime.ToString("hh:mm tt");
    }

    private void OpenSessionDetails(ClassSessionDto session)
    {
        _selectedSession = session;
        _showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
        _selectedSession = null;
    }

    private void RequestUpdateSessionStatus(string status)
    {
        if (_selectedSession != null && _selectedSession.Status == status)
        {
            _alertTitle = "Already Marked";
            _alertMessage = $"Already Marked As {status}";
            _showAlertModal = true;
            return;
        }
        _confirmStatus = status;
        _showStatusConfirmModal = true;
    }

    private async Task ConfirmStatusChange()
    {
        _showStatusConfirmModal = false;
        await UpdateSessionStatus(_confirmStatus);
    }

    private void CancelStatusChange()
    {
        _showStatusConfirmModal = false;
    }

    private async Task UpdateSessionStatus(string status)
    {
        if (_selectedSession == null) return;
        
        _isUpdating = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/classsessions/{_selectedSession.Id}/status", new { Status = status });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResult>();
                if (result != null && result.IsSuccess)
                {
                    _selectedSession.Status = status;
                    _showDetailsModal = false;
                    _selectedSession = null;
                    _message = "Status updated successfully.";
                    _isError = false;
                }
                else
                {
                    _message = result?.Message ?? "Failed to update session status.";
                    _isError = true;
                }
            }
            else
            {
                _message = await response.GetFriendlyErrorMessageAsync("Error updating session status");
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = ex.GetFriendlyErrorMessage("Error updating status");
            _isError = true;
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private string GetSessionStyleClass(string status)
    {
        return status switch
        {
            "Present" => "bg-[#A6FA53]/25 border-black text-foreground hover:bg-[#A6FA53]/40",
            "Absent" => "bg-[#FF6B6B]/25 border-black text-foreground hover:bg-[#FF6B6B]/40",
            "Late" => "bg-[#FFD026]/25 border-black text-foreground hover:bg-[#FFD026]/40",
            "Cancelled" => "bg-muted/40 border-border text-muted-foreground line-through opacity-70",
            "Holiday" => "bg-[#C084FC]/25 border-black text-foreground hover:bg-[#C084FC]/40",
            _ => "bg-card border-border text-foreground hover:bg-muted"
        };
    }

    private string GetBadgeClass(string status)
    {
        return status switch
        {
            "Present" => "bg-[#A6FA53] text-black font-black font-mono border-2 border-black shadow-neo-sm px-3 py-0.5 rounded-md text-xs",
            "Absent" => "bg-[#FF6B6B] text-black font-black font-mono border-2 border-black shadow-neo-sm px-3 py-0.5 rounded-md text-xs",
            "Late" => "bg-[#FFD026] text-black font-black font-mono border-2 border-black shadow-neo-sm px-3 py-0.5 rounded-md text-xs",
            _ => "bg-card text-foreground font-bold font-mono border-2 border-border shadow-neo-sm px-3 py-0.5 rounded-md text-xs"
        };
    }



    private string FormatGoogleCalendarTime(DateTime utcTime)
    {
        var localTime = utcTime + MyanmarOffset;
        if (localTime.Minute == 0)
        {
            return localTime.ToString("htt").ToLower();
        }
        return localTime.ToString("h:mmtt").ToLower();
    }

    private string GetDotColorClass(string status)
    {
        return status switch
        {
            "Present" => "bg-[#A6FA53] border border-black",
            "Absent" => "bg-[#FF6B6B] border border-black",
            "Late" => "bg-[#FFD026] border border-black",
            "Cancelled" => "bg-muted-foreground border border-black",
            "Holiday" => "bg-[#C084FC] border border-black",
            _ => "bg-foreground border border-black"
        };
    }


}
