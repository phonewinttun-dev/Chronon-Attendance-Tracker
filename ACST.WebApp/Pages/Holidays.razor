@page "/holidays"
@using ACST.WebApp.Models
@inject HttpClient Http
@inject AuthStateService AuthState

<PageTitle>Holidays</PageTitle>

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-foreground font-sans">Holidays</h1>
        <p class="text-muted-foreground text-xs font-mono mt-1">Manage public holidays which are excluded from attendance tracking.</p>
    </div>
    @if (_googleCalendarEnabled)
    {
        <div class="flex items-center gap-3">
            <button class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider cursor-pointer" @onclick="ToggleFetchPanel">
                Fetch from Google Calendar
            </button>
        </div>
    }
</div>

@if (_showFetchPanel)
{
    <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo mb-8 font-mono">
        <h2 class="text-base font-black mb-4 text-foreground tracking-tight font-sans">Fetch Holidays from Google Calendar</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div>
                <label class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1">Google Calendar ID</label>
                <input type="text" class="w-full p-2 bg-card border-2 border-border rounded-lg text-foreground font-mono font-bold text-xs shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-primary h-9" @bind="_calendarId" placeholder="e.g. en.mm#holiday@group.v.calendar.google.com" />
                <p class="text-[10px] text-muted-foreground mt-1">Use <code>en.mm#holiday@group.v.calendar.google.com</code> for Myanmar, <code>en.usa#holiday@group.v.calendar.google.com</code> for US.</p>
            </div>
            <div>
                <label class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1">Start Date</label>
                <DatePicker @bind-Value="_startDate" />
            </div>
            <div>
                <label class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1">End Date</label>
                <DatePicker @bind-Value="_endDate" />
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <button class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider cursor-pointer disabled:opacity-50" @onclick="FetchGoogleHolidays" disabled="@_isFetching">
                @(_isFetching ? "Fetching..." : "Fetch & Save")
            </button>
            <button class="neo-btn bg-card text-foreground border-2 border-border px-4 py-2 rounded-xl text-xs font-bold shadow-neo-sm hover:bg-muted cursor-pointer" @onclick="ToggleFetchPanel" disabled="@_isFetching">
                Cancel
            </button>
        </div>
    </div>
}

<div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo-lg overflow-hidden font-mono">
    @if (_isLoading)
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs animate-pulse">
                <thead>
                    <tr class="border-b-2 border-black dark:border-zinc-700 bg-muted/40">
                        <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground">Name</th>
                        <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground">Date</th>
                        @if (AuthState.IsAdmin)
                        {
                            <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground w-28">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y-2 divide-border/60">
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td class="px-6 py-4">
                                <div class="h-3 bg-muted rounded w-36"></div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="h-3 bg-muted rounded w-20"></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_holidays == null || !_holidays.Any())
    {
        <div class="p-8 text-center text-muted-foreground text-xs font-mono font-bold">No holidays found.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b-2 border-black dark:border-zinc-700 bg-muted/40">
                        <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground">Name</th>
                        <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground">Date</th>
                        @if (AuthState.IsAdmin)
                        {
                            <th class="px-6 py-3.5 font-bold uppercase tracking-wider text-foreground w-28">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y-2 divide-border/60">
                    @foreach (var holiday in _holidays)
                    {
                        <tr class="hover:bg-primary/10 transition-colors">
                            <td class="px-6 py-3.5 text-foreground font-bold font-sans">@holiday.Name</td>
                            <td class="px-6 py-3.5 font-mono text-muted-foreground font-bold">@holiday.HolidayDate.ToString("dd-MM-yyyy")</td>
                            @if (AuthState.IsAdmin)
                            {
                                <td class="px-6 py-3.5">
                                    <button class="neo-btn-destructive px-3 py-1.5 min-h-[44px] rounded-lg text-xs font-bold shadow-neo-sm cursor-pointer w-20 flex items-center justify-center" @onclick="() => RequestDeleteHoliday(holiday)">Delete</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="border-t-2 border-black dark:border-zinc-700 bg-card">
            <PaginationControl PageNumber="@_pageNumber" TotalPages="@_totalPages" PageChanged="OnPageChanged" />
        </div>
    }
</div>

@if (_showErrorDialog)
{
    <div class="neo-scrim flex items-center justify-center z-[100] animate-in fade-in duration-200">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 max-w-sm w-full shadow-neo-xl text-center animate-in zoom-in duration-200 font-mono">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-xl bg-destructive/20 text-destructive border-2 border-black shadow-neo-sm mb-4">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-foreground mb-2">Error</h3>
            <p class="text-xs text-muted-foreground mb-5 font-sans">Unexpected Error Ocurred. Please try again</p>
            <button class="neo-btn-primary w-full py-2.5 rounded-xl text-xs font-black shadow-neo"
                    @onclick="() => { _showErrorDialog = false; }">
                Close
            </button>
        </div>
    </div>
}

@if (_showDeleteConfirmModal && _holidayToDelete != null)
{
    <div class="neo-scrim flex items-center justify-center z-[150] animate-in fade-in duration-200 p-4" @onclick="CancelDeleteHoliday">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl p-6 max-w-sm w-full shadow-neo animate-in zoom-in-95 duration-200 font-mono" @onclick:stopPropagation>
            <div class="flex items-start gap-3 mb-4">
                <div class="p-2.5 bg-destructive/20 text-destructive border-2 border-black rounded-lg shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                </div>
                <div>
                    <h3 class="text-base font-black text-foreground font-sans">Delete Holiday?</h3>
                    <p class="text-xs text-muted-foreground mt-1 font-mono">Are you sure you want to delete this holiday? This action cannot be undone.</p>
                </div>
            </div>

            <div class="p-3 bg-muted/40 border-2 border-border rounded-lg text-xs space-y-1 mb-5">
                <div class="font-black text-foreground font-sans">@_holidayToDelete.Name</div>
                <div class="text-muted-foreground">Date: <span class="font-bold text-foreground">@_holidayToDelete.HolidayDate.ToString("dd-MM-yyyy")</span></div>
            </div>

            <div class="flex justify-end gap-3 font-sans">
                <button type="button" 
                        class="neo-btn bg-card text-foreground border-2 border-border px-4 py-2 rounded-xl text-xs font-bold shadow-neo-sm hover:bg-muted cursor-pointer" 
                        @onclick="CancelDeleteHoliday">
                    Cancel
                </button>
                <button type="button" 
                        class="neo-btn-destructive px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider cursor-pointer" 
                        @onclick="ConfirmDeleteHoliday" disabled="@_isDeleting">
                    @(_isDeleting ? "Deleting..." : "Yes, Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<HolidayDto>? _holidays;
    private bool _isLoading = true;
    private bool _showErrorDialog = false;
    private bool _showDeleteConfirmModal = false;
    private HolidayDto? _holidayToDelete;
    private bool _isDeleting = false;

    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private int _totalCount = 0;
    private bool _hasPrevious = false;
    private bool _hasNext = false;

    private bool _showFetchPanel = false;
    private string _calendarId = "en.mm#holiday@group.v.calendar.google.com";
    private DateOnly _startDate = new DateOnly(DateTime.Today.Year, 1, 1);
    private DateOnly _endDate = new DateOnly(DateTime.Today.Year, 12, 31);
    private bool _isFetching = false;

    private bool _googleCalendarEnabled = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoogleCalendarStatus();
        await LoadHolidays();
    }

    private async Task LoadGoogleCalendarStatus()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<GoogleCalendarStatusResponse>("api/google-auth/status");
            if (status != null)
            {
                _googleCalendarEnabled = status.IsEnabled;
            }
        }
        catch (Exception)
        {
            _googleCalendarEnabled = false;
        }
    }

    private class GoogleCalendarStatusResponse
    {
        public bool IsEnabled { get; set; }
        public bool IsConnected { get; set; }
    }

    private async Task OnPageChanged(int newPage)
    {
        _pageNumber = newPage;
        await LoadHolidays();
    }

    private async Task LoadHolidays()
    {
        _isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<HolidayDto>>($"api/holidays?pageNumber={_pageNumber}&pageSize={_pageSize}");
            if (result != null && result.IsSuccess)
            {
                _holidays = result.Data;
                _pageNumber = result.Pagination.PageNumber;
                _pageSize = result.Pagination.PageSize;
                _totalPages = result.Pagination.TotalPages;
                _totalCount = result.Pagination.TotalCount;
                _hasPrevious = result.Pagination.HasPreviousPage;
                _hasNext = result.Pagination.HasNextPage;
            }
        }
        catch (Exception)
        {
            await Toast.Error("Unexpected error occurred. Please try again.");
            _showErrorDialog = true;
        }
        finally
        {
            _isLoading = false;
        }
    }



    private void RequestDeleteHoliday(HolidayDto holiday)
    {
        _holidayToDelete = holiday;
        _showDeleteConfirmModal = true;
    }

    private void CancelDeleteHoliday()
    {
        _showDeleteConfirmModal = false;
        _holidayToDelete = null;
    }

    private async Task ConfirmDeleteHoliday()
    {
        if (_holidayToDelete == null) return;
        _isDeleting = true;
        try
        {
            await DeleteHoliday(_holidayToDelete.Id);
        }
        finally
        {
            _isDeleting = false;
            _showDeleteConfirmModal = false;
            _holidayToDelete = null;
        }
    }

    private async Task DeleteHoliday(long id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/holidays/{id}");
            if (response.IsSuccessStatusCode)
            {
                await Toast.Success("Holiday deleted successfully.");
                if (_holidays != null && _holidays.Count == 1 && _pageNumber > 1)
                {
                    _pageNumber--;
                }
                await LoadHolidays();
            }
            else
            {
                await Toast.Error(await response.GetFriendlyErrorMessageAsync("Error deleting holiday"));
            }
        }
        catch (Exception ex)
        {
            await Toast.Error(ex.GetFriendlyErrorMessage("Error deleting holiday"));
        }
    }

    private void ToggleFetchPanel()
    {
        _showFetchPanel = !_showFetchPanel;
    }

    private async Task FetchGoogleHolidays()
    {
        if (string.IsNullOrWhiteSpace(_calendarId))
        {
            await Toast.Warning("Validation Error", "Google Calendar ID is required.");
            return;
        }

        if (_startDate > _endDate)
        {
            await Toast.Warning("Validation Error", "Start date must be before or equal to end date.");
            return;
        }

        _isFetching = true;

        try
        {
            var request = new ImportGoogleHolidaysRequest
            {
                CalendarId = _calendarId,
                StartDate = _startDate,
                EndDate = _endDate
            };

            var response = await Http.PostAsJsonAsync("api/holidays/import-google", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResult<int>>();
                if (result != null && result.IsSuccess)
                {
                    await Toast.Success(result.Message);
                    _showFetchPanel = false;
                    _pageNumber = 1;
                    await LoadHolidays();
                }
                else
                {
                    await Toast.Error(result?.Message ?? "Unknown error fetching holidays.");
                }
            }
            else
            {
                await Toast.Error(await response.GetFriendlyErrorMessageAsync("Error fetching holidays"));
            }
        }
        catch (Exception ex)
        {
            await Toast.Error(ex.GetFriendlyErrorMessage("Error fetching holidays"));
        }
        finally
        {
            _isFetching = false;
        }
    }
}
