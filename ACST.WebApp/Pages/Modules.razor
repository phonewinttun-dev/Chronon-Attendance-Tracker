                                    <td class="px-4 py-3.5 text-muted-foreground font-mono font-bold">@mod.TeacherName</td>
                                    <td class="px-4 py-3.5 text-muted-foreground font-mono font-bold">@(string.IsNullOrEmpty(mod.SemesterName) ? "None" : mod.SemesterName)</td>
                                    <td class="px-4 py-3.5 text-muted-foreground">
                                        @if (mod.Schedules != null && mod.Schedules.Any())
                                        {
                                            var activeDays = mod.Schedules.Select(s => s.DayOfWeek).ToHashSet();
                                            <div class="flex items-center gap-1 mb-2" role="group" aria-label="Weekly class schedule distribution">
                                                @foreach (var day in new[] { ((short)1, "M", "Monday"), ((short)2, "T", "Tuesday"), ((short)3, "W", "Wednesday"), ((short)4, "T", "Thursday"), ((short)5, "F", "Friday"), ((short)6, "S", "Saturday"), ((short)0, "S", "Sunday") })
                                                {
                                                    var isScheduled = activeDays.Contains(day.Item1);
                                                    <span class="inline-flex items-center justify-center w-5 h-5 text-[10px] font-mono font-bold rounded border @(isScheduled ? "bg-primary text-black border-border shadow-neo-sm font-black" : "bg-muted/30 text-muted-foreground/40 border-border/20")"
                                                          title="@(isScheduled ? $"Scheduled on {day.Item3}" : $"No classes on {day.Item3}")">
                                                        @day.Item2
                                                    </span>
                                                }
                                            </div>
                                            <div class="flex flex-col gap-1.5">
                                                @foreach (var schedule in mod.Schedules)
                                                {
                                                    <div class="inline-flex items-center justify-between gap-2 bg-card border-2 border-border shadow-neo-sm px-2.5 py-1 rounded-lg text-xs text-foreground font-mono font-bold w-max">
                                                        <div class="flex flex-col gap-0.5">
                                                            <span>@GetDayOfWeekName(schedule.DayOfWeek): @FormatTime(schedule.StartTime) - @FormatTime(schedule.EndTime)</span>
                                                            @if (schedule.EffectiveStartDate.HasValue || schedule.EffectiveEndDate.HasValue)
                                                            {
                                                                var status = ScheduleUiHelper.GetLifecycleStatus(schedule.EffectiveStartDate, schedule.EffectiveEndDate);
                                                                if (status == ScheduleLifecycleStatus.Active)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/20 text-foreground border border-primary w-max">
                                                                        @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                                    </span>
                                                                }
                                                                else if (status == ScheduleLifecycleStatus.Upcoming)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-tertiary/20 text-foreground border border-tertiary w-max">
                                                                        @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                                    </span>
                                                                }
                                                                else if (status == ScheduleLifecycleStatus.Concluded)
                                                                {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono text-muted-foreground bg-muted/60 border border-border/40 line-through decoration-border w-max">
                                                                        @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                                    </span>
                                                                }
                                                            }
                                                        </div>
                                                        <button class="text-destructive hover:bg-destructive/10 rounded font-black focus:outline-none focus:ring-1 focus:ring-destructive cursor-pointer text-sm leading-none ml-1 p-0.5" @onclick="() => OpenDeleteScheduleConfirm(schedule.Id)" @onclick:stopPropagation aria-label="Delete schedule" title="Delete schedule">×</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-foreground text-xs italic font-mono">No schedule</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3.5">
                                        @if (mod.TotalValidSessions > 0)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="px-2.5 py-0.5 rounded-md text-xs font-black font-mono border-2 @GetBadgeBorderAndBg(mod.AttendanceRate)">
                                                    @mod.AttendanceRate%
                                                </span>
                                                <span class="text-muted-foreground text-[10px] font-mono font-bold">(@mod.PresentSessions/@mod.TotalValidSessions)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-foreground font-mono font-bold">-</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3.5 whitespace-nowrap">
                                        <div class="flex items-center gap-2 font-mono">
                                            <button class="neo-btn bg-card text-foreground border-2 border-border px-3 py-1.5 min-h-[44px] sm:min-h-0 rounded-lg text-xs font-bold shadow-neo-sm hover:bg-muted cursor-pointer inline-flex items-center justify-center" @onclick="() => OpenScheduleForm(mod)">Add Schedule</button>
                                            <button class="neo-btn bg-card text-foreground border-2 border-border px-3 py-1.5 min-h-[44px] sm:min-h-0 rounded-lg text-xs font-bold shadow-neo-sm hover:bg-muted cursor-pointer inline-flex items-center justify-center" @onclick="() => OpenEditForm(mod)">Edit</button>
                                            <button class="neo-btn-destructive py-1.5 px-3 min-h-[44px] sm:min-h-0 rounded-lg text-xs font-bold shadow-neo-sm cursor-pointer disabled:opacity-50 inline-flex items-center justify-center" 
                                                    @onclick="() => RequestDeleteModule(mod.Id)" 
                                                    disabled="@_deletingModuleIds.Contains(mod.Id)">
                                                @(_deletingModuleIds.Contains(mod.Id) ? "Deleting..." : "Delete")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="border-t-2 border-black dark:border-zinc-700 bg-card">
                    <PaginationControl PageNumber="@_pageNumber" TotalPages="@_totalPages" PageChanged="OnPageChanged" />
                </div>
            }
        </div>
    }
    else
    {
        @if (_isLoading)
        {
            <div class="flex flex-wrap justify-center gap-4 animate-pulse">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="bg-card border-2 border-border rounded-xl p-5 flex flex-col justify-between shadow-neo-sm w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] flex-grow max-w-[400px]">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <div class="h-4 bg-muted rounded w-24"></div>
                                <div class="h-4 bg-muted rounded w-20"></div>
                            </div>
                            <div class="h-3 bg-muted rounded w-28 mb-4"></div>
                        </div>
                        <div class="flex gap-2 border-t-2 border-border/60 pt-4 mt-2 font-mono">
                            <div class="h-7 bg-muted rounded-lg flex-1"></div>
                            <div class="h-7 bg-muted rounded-lg w-12"></div>
                            <div class="h-7 bg-muted rounded-lg w-16"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_modules == null || !_modules.Any())
        {
            <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo p-8 text-center text-muted-foreground text-xs font-mono font-bold">No modules found. Create one to get started.</div>
        }
        else
        {
            <div class="flex flex-wrap justify-center gap-5 font-mono">
                @foreach (var mod in _modules)
                {
                    <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl p-5 flex flex-col justify-between shadow-neo hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] flex-grow max-w-[400px]">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <div class="mb-1.5">
                                        <span class="px-2 py-0.5 text-[10px] font-mono font-black bg-accent text-black border-2 border-black shadow-neo-sm rounded-md">@mod.ModuleCode</span>
                                    </div>
                                    <h3 class="text-base font-black text-foreground tracking-tight font-sans">@mod.Name</h3>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground mt-1 font-mono font-bold">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        <span>@mod.TeacherName</span>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end gap-1.5 shrink-0">
                                    <span class="px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wider rounded-md border-2 @(string.IsNullOrEmpty(mod.SemesterName) ? "bg-card text-muted-foreground border-border" : "bg-primary text-black border-black shadow-neo-sm")">
                                        @(string.IsNullOrEmpty(mod.SemesterName) ? "No Semester" : mod.SemesterName)
                                    </span>
                                    @if (mod.TotalValidSessions > 0)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-md text-xs font-black font-mono border-2 @GetBadgeBorderAndBg(mod.AttendanceRate)">
                                            @mod.AttendanceRate%
                                        </span>
                                    }
                                </div>
                            </div>
                            
                            <!-- Attendance Metrics -->
                            @if (mod.TotalValidSessions > 0)
                            {
                                <div class="grid grid-cols-2 gap-y-1.5 gap-x-4 text-xs font-mono text-muted-foreground border-t-2 border-border/40 pt-3 mb-4 font-bold">
                                    <div>Total Valid: <span class="text-foreground">@mod.TotalValidSessions</span></div>
                                    <div>Present: <span class="text-primary font-black">@mod.PresentSessions</span></div>
                                    <div>Absent: <span class="text-destructive font-black">@mod.AbsentSessions</span></div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-4 text-xs text-muted-foreground italic border-t-2 border-border/40 pt-3 font-mono">
                                    No sessions scheduled.
                                </div>
                            }

                            <!-- Timetables / Schedules -->
                            <div class="border-t-2 border-border/40 pt-3 mb-4">
                                <label class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5 font-mono">Timetables</label>
                                @if (mod.Schedules != null && mod.Schedules.Any())
                                {
                                    var activeDays = mod.Schedules.Select(s => s.DayOfWeek).ToHashSet();
                                    <div class="flex items-center gap-1 mb-2.5" role="group" aria-label="Weekly class schedule distribution">
                                        @foreach (var day in new[] { ((short)1, "M", "Monday"), ((short)2, "T", "Tuesday"), ((short)3, "W", "Wednesday"), ((short)4, "T", "Thursday"), ((short)5, "F", "Friday"), ((short)6, "S", "Saturday"), ((short)0, "S", "Sunday") })
                                        {
                                            var isScheduled = activeDays.Contains(day.Item1);
                                            <span class="inline-flex items-center justify-center w-5 h-5 text-[10px] font-mono font-bold rounded border @(isScheduled ? "bg-primary text-black border-border shadow-neo-sm font-black" : "bg-muted/30 text-muted-foreground/40 border-border/20")"
                                                  title="@(isScheduled ? $"Scheduled on {day.Item3}" : $"No classes on {day.Item3}")">
                                                @day.Item2
                                            </span>
                                        }
                                    </div>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var schedule in mod.Schedules)
                                        {
                                            <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-card text-foreground border-2 border-border shadow-neo-sm rounded-lg font-mono text-xs font-bold">
                                                <div class="flex flex-col gap-0.5">
                                                    <span>@GetDayOfWeekName(schedule.DayOfWeek): @FormatTime(schedule.StartTime)-@FormatTime(schedule.EndTime)</span>
                                                    @if (schedule.EffectiveStartDate.HasValue || schedule.EffectiveEndDate.HasValue)
                                                    {
                                                        var status = ScheduleUiHelper.GetLifecycleStatus(schedule.EffectiveStartDate, schedule.EffectiveEndDate);
                                                        if (status == ScheduleLifecycleStatus.Active)
                                                        {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/20 text-foreground border border-primary w-max">
                                                                @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                            </span>
                                                        }
                                                        else if (status == ScheduleLifecycleStatus.Upcoming)
                                                        {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-tertiary/20 text-foreground border border-tertiary w-max">
                                                                @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                            </span>
                                                        }
                                                        else if (status == ScheduleLifecycleStatus.Concluded)
                                                        {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono text-muted-foreground bg-muted/60 border border-border/40 line-through decoration-border w-max">
                                                                @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                                <button class="text-destructive hover:bg-destructive/10 rounded font-black focus:outline-none focus:ring-1 focus:ring-destructive cursor-pointer text-sm leading-none ml-1 p-0.5" @onclick="() => OpenDeleteScheduleConfirm(schedule.Id)" @onclick:stopPropagation aria-label="Delete schedule" title="Delete schedule">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs italic font-mono">No schedule assigned</span>
                                }
                            </div>
                        </div>
                        <div class="flex gap-2 border-t-2 border-border/60 pt-4 mt-2 font-mono">
                            <button class="neo-btn flex-1 text-center bg-card hover:bg-muted text-foreground border-2 border-border py-1.5 rounded-lg text-xs font-bold shadow-neo-sm cursor-pointer" @onclick="() => OpenScheduleForm(mod)">Add Schedule</button>
                            <button class="neo-btn text-center bg-card hover:bg-muted text-foreground border-2 border-border px-3 py-1.5 rounded-lg text-xs font-bold shadow-neo-sm cursor-pointer" @onclick="() => OpenEditForm(mod)">Edit</button>
                            <button class="neo-btn-destructive text-center px-3 py-1.5 rounded-lg text-xs font-bold shadow-neo-sm cursor-pointer disabled:opacity-50" 
                                    @onclick="() => RequestDeleteModule(mod.Id)" 
                                    disabled="@_deletingModuleIds.Contains(mod.Id)">
                                @(_deletingModuleIds.Contains(mod.Id) ? "Deleting..." : "Delete")
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="border-2 border-black dark:border-zinc-700 rounded-xl bg-card mt-6 shadow-neo overflow-hidden">
                <PaginationControl PageNumber="@_pageNumber" TotalPages="@_totalPages" PageChanged="OnPageChanged" />
            </div>
        }
    }
}

