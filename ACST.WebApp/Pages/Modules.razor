    private async Task DeleteModule(long id)
    {
        if (_deletingModuleIds.Contains(id)) return;
        _deletingModuleIds.Add(id);
        try
        {
            var response = await Http.DeleteAsync($"api/modules/{id}");
            if (response.IsSuccessStatusCode)
            {
                await Toast.Success("Module deleted successfully.");
                if (_modules != null && _modules.Count == 1 && _pageNumber > 1)
                {
                    _pageNumber--;
                }
                await LoadData();
            }
            else
            {
                await Toast.Error(await response.GetFriendlyErrorMessageAsync("Error deleting module"));
            }
        }
        catch (Exception ex)
        {
            await Toast.Error(ex.GetFriendlyErrorMessage("Error deleting module"));
        }
        finally
        {
            _deletingModuleIds.Remove(id);
        }
    }

    private string GetHealthColorClass(double rate)
