@page "/modules"
@using ACST.WebApp.Models
@inject HttpClient Http

<PageTitle>Modules</PageTitle>

<div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-black tracking-tight text-foreground font-sans">Modules</h1>
    <div class="flex items-center gap-3">
        <div class="flex items-center gap-1 bg-card border-2 border-border p-0.5 rounded-lg shadow-neo-sm">
            <button class="p-1.5 rounded-md transition-all cursor-pointer @(_viewMode == "table" ? "bg-accent text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")" 
                    @onclick='() => _viewMode = "table"' 
                    title="Table View">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
            </button>
            <button class="p-1.5 rounded-md transition-all cursor-pointer @(_viewMode == "card" ? "bg-accent text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")" 
                    @onclick='() => _viewMode = "card"' 
                    title="Card View">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            </button>
        </div>
        <button class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider cursor-pointer" @onclick="ToggleCreateForm">
            @(_showCreateForm ? "Cancel" : "New Module")
        </button>
    </div>
</div>

@if (!_showCreateForm && !_showEditForm && _selectedModuleId == 0)
{
    <div class="flex flex-wrap items-center gap-3 mb-6 bg-card border-2 border-black dark:border-zinc-700 p-5 rounded-xl shadow-neo font-mono">
        <!-- Search Box -->
        <div class="flex-1 min-w-[240px] flex flex-col gap-1.5">
            <label class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Search Modules</label>
            <div class="relative flex items-center">
                <input type="text" 
                       class="w-full pl-9 pr-24 py-2.5 bg-card border-2 border-border rounded-lg text-foreground text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-primary shadow-neo-sm transition-all placeholder:text-muted-foreground" 
                       placeholder="Search by module name or code" 
                       @bind="_searchTerm" 
                       @onkeyup="OnSearchKeyUp" />
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                @if (!string.IsNullOrEmpty(_searchTerm))
                {
                    <button class="absolute right-[86px] text-muted-foreground hover:text-foreground text-xs font-black focus:outline-none cursor-pointer" @onclick="ClearSearch" title="Clear search">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                }
                <button class="absolute right-0 top-0 bottom-0 px-4 bg-primary text-black font-mono font-black border-l-2 border-border rounded-r-md text-xs uppercase tracking-wider transition-all focus:outline-none hover:bg-primary/90 cursor-pointer" @onclick="TriggerSearch">
                    Search
                </button>
            </div>
        </div>

        <!-- Semester Filter -->
        <div class="flex flex-col gap-1.5 min-w-[200px]">
            <label class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Semester</label>
            <CustomSelect TValue="string"
                          Value="_selectedFilterSemesterIdStr"
                          ValueChanged="OnSemesterFilterChanged"
                          Placeholder="All Semesters">
                <CustomSelectOption TValue="string" Value='""' Text="All Semesters" />
                @if (_semesters != null)
                {
                    @foreach (var sem in _semesters)
                    {
                        <CustomSelectOption TValue="string" Value="@sem.Id.ToString()" Text="@sem.Name" />
                    }
                }
            </CustomSelect>
        </div>
    </div>
}


@if (_showCreateForm)
{
    <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo mb-8 font-mono">
        <h2 class="text-base font-black mb-4 text-foreground tracking-tight font-sans">Create New Module</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div>
                <label class="block text-xs font-bold text-foreground mb-1 uppercase tracking-wider font-mono">Module Name</label>
                <input type="text" class="w-full p-2.5 bg-background border-2 border-border rounded-lg text-foreground font-mono font-bold text-xs shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-primary" @bind="_newModule.Name" placeholder="e.g. Introduction to CS" />
            </div>
            <div>
                <label class="block text-xs font-bold text-foreground mb-1 uppercase tracking-wider font-mono">Module Code</label>
                <input type="text" class="w-full p-2.5 bg-background border-2 border-border rounded-lg text-foreground font-mono font-bold text-xs shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-primary" @bind="_newModule.ModuleCode" placeholder="e.g. CS-101" />
            </div>
            <div>
                <label class="block text-xs font-bold text-foreground mb-1 uppercase tracking-wider font-mono">Teacher Name</label>
                <input type="text" class="w-full p-2.5 bg-background border-2 border-border rounded-lg text-foreground font-mono font-bold text-xs shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-primary" @bind="_newModule.TeacherName" placeholder="e.g. John Doe" />
            </div>
            <div>
                <label class="block text-xs font-bold text-foreground mb-1 uppercase tracking-wider font-mono">Semester</label>
                <CustomSelect TValue="string"
                              @bind-Value="_newModuleSemesterIdStr"
                              Placeholder="Select Semester (Optional)...">
                    <CustomSelectOption TValue="string" Value='""' Text="Select Semester (Optional)..." />
                    @if (_semesters != null)
                    {
                        @foreach(var sem in _semesters)
                        {
                            <CustomSelectOption TValue="string" Value="@sem.Id.ToString()" Text="@sem.Name" />
                        }
                    }
                </CustomSelect>
            </div>
        </div>

        <div class="mt-6 border-t-2 border-border/40 pt-4 mb-6">
            <h3 class="text-sm font-black text-foreground mb-4 font-sans">Schedules</h3>
            
            @if (!_newModuleSchedules.Any())
            {
                <p class="text-xs text-muted-foreground italic mb-4 font-mono">No schedules added yet. Click the button below to add a schedule.</p>
            }
            else
            {
                var newSem = GetNewModuleSemester();
                var valStates = GetNewModuleValidationStates();
                <div class="space-y-3 mb-4">
                    @for (int i = 0; i < _newModuleSchedules.Count; i++)
                    {
                        var index = i;
                        var sch = _newModuleSchedules[i];
                        var valState = i < valStates.Count ? valStates[i] : new ScheduleValidationState();
                        <div class="bg-muted/20 p-3.5 rounded-xl border-2 @(valState.HasErrors ? "border-destructive/60 bg-destructive/5" : "border-border") shadow-neo-sm space-y-3">
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">Day of Week</label>
                                    <CustomSelect TValue="short"
                                                  @bind-Value="sch.DayOfWeek"
                                                  Size="sm">
                                        <CustomSelectOption TValue="short" Value="@((short)1)" Text="Monday" />
                                        <CustomSelectOption TValue="short" Value="@((short)2)" Text="Tuesday" />
                                        <CustomSelectOption TValue="short" Value="@((short)3)" Text="Wednesday" />
                                        <CustomSelectOption TValue="short" Value="@((short)4)" Text="Thursday" />
                                        <CustomSelectOption TValue="short" Value="@((short)5)" Text="Friday" />
                                        <CustomSelectOption TValue="short" Value="@((short)6)" Text="Saturday" />
                                        <CustomSelectOption TValue="short" Value="@((short)0)" Text="Sunday" />
                                    </CustomSelect>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">Start Time</label>
                                    <input type="time" class="w-full p-2 bg-background border-2 @(valState.HasTimeError ? "border-destructive focus:ring-destructive" : "border-border focus:ring-primary") rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2" 
                                           @bind="sch.StartTime" aria-label="Start time" aria-invalid="@(valState.HasTimeError ? "true" : "false")" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">End Time</label>
                                    <input type="time" class="w-full p-2 bg-background border-2 @(valState.HasTimeError ? "border-destructive focus:ring-destructive" : "border-border focus:ring-primary") rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2" 
                                           @bind="sch.EndTime" aria-label="End time" aria-invalid="@(valState.HasTimeError ? "true" : "false")" />
                                </div>
                                <div class="flex justify-end">
                                    <button type="button" class="neo-btn-destructive px-3 py-2 rounded-lg text-xs font-bold shadow-neo-sm w-full md:w-auto cursor-pointer" 
                                            @onclick="() => RemoveNewModuleSchedule(index)" aria-label="Remove schedule">
                                        Remove
                                    </button>
                                </div>
                            </div>

                            <!-- Schedule Scope Selector & Effective Date Range -->
                            <div class="pt-2.5 border-t border-border/40 space-y-2.5">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                    <label class="text-xs font-bold text-foreground font-mono uppercase tracking-wider">Schedule Scope</label>
                                    <div class="inline-flex p-0.5 bg-muted rounded-lg border-2 border-border shadow-neo-sm" role="radiogroup" aria-label="Schedule scope">
                                        <button type="button"
                                                class="px-2.5 py-1 text-xs font-mono font-bold rounded-md transition-all cursor-pointer @(!sch.IsCustomRange ? "bg-card text-foreground shadow-sm border border-border" : "text-muted-foreground hover:text-foreground")"
                                                @onclick="() => ToggleScheduleScope(sch, false)">
                                            Full Semester
                                        </button>
                                        <button type="button"
                                                class="px-2.5 py-1 text-xs font-mono font-bold rounded-md transition-all cursor-pointer @(sch.IsCustomRange ? "bg-card text-foreground shadow-sm border border-border" : "text-muted-foreground hover:text-foreground")"
                                                @onclick="() => ToggleScheduleScope(sch, true)">
                                            Custom Date Range
                                        </button>
                                    </div>
                                </div>

                                @if (!sch.IsCustomRange)
                                {
                                    <div class="bg-card/60 p-2.5 rounded-lg border border-border/60 flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-block w-2 h-2 rounded-full bg-primary border border-border"></span>
                                            <span class="text-xs font-mono text-muted-foreground">
                                                @if (newSem != null)
                                                {
                                                    <span>Active for full semester: <strong>@newSem.StartDate.ToString("MMM dd, yyyy")</strong> to <strong>@newSem.EndDate.ToString("MMM dd, yyyy")</strong></span>
                                                }
                                                else
                                                {
                                                    <span>Active for the entire semester duration.</span>
                                                }
                                            </span>
                                        </div>
                                        <span class="text-[10px] font-mono uppercase font-bold text-muted-foreground bg-muted px-2 py-0.5 rounded border border-border">Standard</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-xs font-bold text-muted-foreground mb-1 font-mono uppercase tracking-wider flex items-center justify-between">
                                                <span>Effective Start Date</span>
                                                <span class="text-[10px] text-muted-foreground bg-card px-1.5 py-0.5 rounded border border-border">Optional</span>
                                            </label>
                                            <input type="date" 
                                                   min="@(newSem?.StartDate.ToString("yyyy-MM-dd"))"
                                                   max="@(newSem?.EndDate.ToString("yyyy-MM-dd"))"
                                                   class="w-full p-2 bg-background border-2 @(valState.HasDateError ? "border-destructive focus:ring-destructive" : "border-border focus:ring-primary") rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2"
                                                   value="@(sch.EffectiveStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   @onchange="@(e => sch.EffectiveStartDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value.ToString()!))" 
                                                   aria-label="Effective start date" 
                                                   aria-invalid="@(valState.HasDateError ? "true" : "false")" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-muted-foreground mb-1 font-mono uppercase tracking-wider flex items-center justify-between">
                                                <span>Effective End Date</span>
                                                <span class="text-[10px] text-muted-foreground bg-card px-1.5 py-0.5 rounded border border-border">Optional</span>
                                            </label>
                                            <input type="date" 
                                                   min="@(newSem?.StartDate.ToString("yyyy-MM-dd"))"
                                                   max="@(newSem?.EndDate.ToString("yyyy-MM-dd"))"
                                                   class="w-full p-2 bg-background border-2 @(valState.HasDateError ? "border-destructive focus:ring-destructive" : "border-border focus:ring-primary") rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2"
                                                   value="@(sch.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   @onchange="@(e => sch.EffectiveEndDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value.ToString()!))" 
                                                   aria-label="Effective end date" 
                                                   aria-invalid="@(valState.HasDateError ? "true" : "false")" />
                                        </div>
                                    </div>
                                    @if (newSem != null)
                                    {
                                        <p class="text-[11px] font-mono text-muted-foreground">Semester window: @newSem.StartDate.ToString("MMM dd, yyyy") to @newSem.EndDate.ToString("MMM dd, yyyy")</p>
                                    }
                                }

                                @if (valState.HasTimeError)
                                {
                                    <p class="text-xs text-destructive font-mono font-bold" role="alert">@valState.TimeErrorMessage</p>
                                }
                                @if (valState.HasDateError)
                                {
                                    <p class="text-xs text-destructive font-mono font-bold" role="alert">@valState.DateErrorMessage</p>
                                }
                                @if (valState.HasConflict)
                                {
                                    <div class="p-2 bg-destructive/10 border-2 border-destructive rounded-lg text-xs font-mono font-bold text-destructive flex items-center gap-2" role="alert">
                                        <span>Conflict:</span>
                                        <span>@valState.ConflictMessage</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            
            <button type="button" class="neo-btn bg-card text-foreground border-2 border-border px-3 py-2 rounded-xl text-xs font-bold shadow-neo-sm hover:bg-muted cursor-pointer" 
                    @onclick="AddNewModuleSchedule">
                + Add Schedule
            </button>
        </div>

        <div class="flex items-center gap-3">
            <button class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider disabled:opacity-50 cursor-pointer" @onclick="OnCreateModuleClicked" disabled="@_isSubmitting">
                @(_isSubmitting ? "Creating..." : "Create Module")
            </button>
            @if (_newModuleSchedules.Any())
            {
                <button type="button" class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider disabled:opacity-50 cursor-pointer" @onclick="OnGenerateSessionsClicked" disabled="@_isSubmitting">
                    Generate Sessions
                </button>
            }
        </div>
    </div>
}

<!-- Assign Schedule Form -->
@if (_selectedModuleId > 0)
{
    <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo mb-8 font-mono">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-base font-black text-foreground tracking-tight font-sans">Add Schedule to @_selectedModuleName</h2>
            <button class="text-muted-foreground hover:text-foreground text-xs font-bold font-mono cursor-pointer" @onclick="CancelScheduleForm">Cancel</button>
        </div>

        <!-- Existing Schedules -->
        @if (_selectedModule != null && _selectedModule.Schedules != null && _selectedModule.Schedules.Any())
        {
            <div class="mb-6 p-4 bg-muted/20 border-2 border-border rounded-xl shadow-neo-sm">
                <h3 class="text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2 font-mono">Existing Timetables</h3>
                
                @{
                    var activeDays = _selectedModule.Schedules.Select(s => s.DayOfWeek).ToHashSet();
                }
                <div class="flex items-center gap-1 mb-3" role="group" aria-label="Weekly class schedule distribution">
                    @foreach (var day in new[] { ((short)1, "M", "Monday"), ((short)2, "T", "Tuesday"), ((short)3, "W", "Wednesday"), ((short)4, "T", "Thursday"), ((short)5, "F", "Friday"), ((short)6, "S", "Saturday"), ((short)0, "S", "Sunday") })
                    {
                        var isScheduled = activeDays.Contains(day.Item1);
                        <span class="inline-flex items-center justify-center w-5 h-5 text-[10px] font-mono font-bold rounded border @(isScheduled ? "bg-primary text-black border-border shadow-neo-sm font-black" : "bg-muted/30 text-muted-foreground/40 border-border/20")"
                              title="@(isScheduled ? $"Scheduled on {day.Item3}" : $"No classes on {day.Item3}")">
                            @day.Item2
                        </span>
                    }
                </div>

                <div class="flex flex-wrap gap-2">
                    @foreach (var schedule in _selectedModule.Schedules)
                    {
                        <div class="inline-flex items-center gap-2 px-2.5 py-1.5 bg-card border-2 border-border shadow-neo-sm text-foreground rounded-lg font-mono text-xs font-bold">
                            <div class="flex flex-col gap-0.5">
                                <span>@GetDayOfWeekName(schedule.DayOfWeek): @FormatTime(schedule.StartTime)-@FormatTime(schedule.EndTime)</span>
                                @if (schedule.EffectiveStartDate.HasValue || schedule.EffectiveEndDate.HasValue)
                                {
                                    var status = ScheduleUiHelper.GetLifecycleStatus(schedule.EffectiveStartDate, schedule.EffectiveEndDate);
                                    if (status == ScheduleLifecycleStatus.Active)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/20 text-foreground border border-primary w-max">
                                            @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                        </span>
                                    }
                                    else if (status == ScheduleLifecycleStatus.Upcoming)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-tertiary/20 text-foreground border border-tertiary w-max">
                                            @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                        </span>
                                    }
                                    else if (status == ScheduleLifecycleStatus.Concluded)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono text-muted-foreground bg-muted/60 border border-border/40 line-through decoration-border w-max">
                                            @ScheduleUiHelper.FormatEffectiveRangeBadge(schedule.EffectiveStartDate, schedule.EffectiveEndDate)
                                        </span>
                                    }
                                }
                            </div>
                            <button class="text-destructive hover:bg-destructive/10 rounded font-black focus:outline-none focus:ring-1 focus:ring-destructive ml-1 text-sm leading-none cursor-pointer p-0.5" 
                                    @onclick="() => OpenDeleteScheduleConfirm(schedule.Id)" @onclick:stopPropagation aria-label="Delete schedule" title="Delete schedule">×</button>
                        </div>
                    }
                </div>
            </div>
        }
        
        <div class="mb-6">
            <label class="block text-xs font-bold text-foreground mb-1 uppercase tracking-wider font-mono">Semester</label>
            <CustomSelect TValue="long"
                          @bind-Value="_selectedSemesterId"
                          Placeholder="Select Semester...">
                <CustomSelectOption TValue="long" Value="0L" Text="Select Semester..." />
                @if (_semesters != null)
                {
                    @foreach(var sem in _semesters)
                    {
                        <CustomSelectOption TValue="long" Value="@sem.Id" Text="@sem.Name" />
                    }
                }
            </CustomSelect>
        </div>

        <div class="mb-6">
            <label class="block text-sm font-bold text-foreground mb-3 font-mono uppercase tracking-wider">Schedules to Add</label>
            
            @if (!_assignSchedules.Any())
            {
                <p class="text-xs text-muted-foreground italic mb-4 font-mono">No schedules added yet. Click the button below to add a schedule.</p>
            }
            else
            {
                var valStates = GetAssignValidationStates();
                <div class="space-y-3 mb-4">
                    @for (int i = 0; i < _assignSchedules.Count; i++)
                    {
                        var index = i;
                        var sch = _assignSchedules[i];
                        var valState = i < valStates.Count ? valStates[i] : new ScheduleValidationState();
                        <div class="bg-muted/20 p-3.5 rounded-xl border-2 @(valState.HasErrors ? "border-destructive/60 bg-destructive/5" : "border-border") shadow-neo-sm space-y-3">
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">Day of Week</label>
                                    <CustomSelect TValue="short"
                                                  @bind-Value="sch.DayOfWeek"
                                                  Size="sm">
                                        <CustomSelectOption TValue="short" Value="@((short)1)" Text="Monday" />
                                        <CustomSelectOption TValue="short" Value="@((short)2)" Text="Tuesday" />
                                        <CustomSelectOption TValue="short" Value="@((short)3)" Text="Wednesday" />
                                        <CustomSelectOption TValue="short" Value="@((short)4)" Text="Thursday" />
                                        <CustomSelectOption TValue="short" Value="@((short)5)" Text="Friday" />
                                        <CustomSelectOption TValue="short" Value="@((short)6)" Text="Saturday" />
                                        <CustomSelectOption TValue="short" Value="@((short)0)" Text="Sunday" />
                                    </CustomSelect>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">Start Time</label>
                                    <input type="time" class="w-full p-2 bg-background border-2 @(valState.HasTimeError ? "border-destructive focus:ring-destructive" : "border-border focus:ring-primary") rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2" 
                                           @bind="sch.StartTime" aria-label="Start time" aria-invalid="@(valState.HasTimeError ? "true" : "false")" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-foreground mb-1 font-mono uppercase tracking-wider">End Time</label>
