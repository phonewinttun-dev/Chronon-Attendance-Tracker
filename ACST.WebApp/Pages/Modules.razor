            <button type="button" class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo uppercase tracking-wider disabled:opacity-50 cursor-pointer" @onclick="OnGenerateSessionsClickedForAssign" disabled="@_isSubmittingSchedule">
