        if (rate >= 60) return "text-amber-500";
        return "text-destructive";
    }

    private string GetHealthBgClass(double rate)
    {
        if (rate >= 75) return "bg-emerald-500";
        if (rate >= 60) return "bg-amber-500";
        return "bg-destructive";
    }

    private string GetBadgeBorderAndBg(double rate)
    {
        if (rate >= 75) return "border-2 border-black bg-primary text-black font-black font-mono shadow-neo-sm";
        if (rate >= 60) return "border-2 border-black bg-accent text-black font-black font-mono shadow-neo-sm";
        return "border-2 border-black bg-destructive text-black font-black font-mono shadow-neo-sm";
    }

