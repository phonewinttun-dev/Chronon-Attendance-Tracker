@page "/attendance"
@using ACST.WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime


<PageTitle>Attendance</PageTitle>

<!-- Header -->
<div class="mb-6">
    <h1 class="text-3xl font-black tracking-tight text-foreground font-sans">Attendance</h1>
    <p class="text-muted-foreground text-xs font-mono mt-1">Mark and manage attendance status for your class sessions.</p>
</div>

<!-- Filters -->
<div class="flex flex-wrap items-end gap-3 mb-6 bg-card border-2 border-black dark:border-zinc-700 p-5 rounded-xl shadow-neo w-full">
    <div class="flex flex-col gap-1.5 flex-1 min-w-[140px]">
        <label class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">Semester</label>
        <select class="w-full p-2 bg-card border-2 border-border rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-[#A6FA53]"
                value="@_selectedSemesterId" @onchange="OnSemesterChanged">
            @if (_semesters != null)
            {
                @foreach (var sem in _semesters)
                {
                    <option value="@sem.Id">@sem.Name</option>
                }
            }
        </select>
    </div>

    <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">Module</label>
        <select class="w-full p-2 bg-card border-2 border-border rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-[#A6FA53]"
                value="@_selectedModuleId" @onchange="OnModuleChanged">
            <option value="">All Modules</option>
            @if (_modules != null)
            {
                @foreach (var mod in _modules)
                {
                    <option value="@mod.Id">@mod.ModuleCode - @mod.Name</option>
                }
            }
        </select>
    </div>

    <div class="flex flex-col gap-1.5 flex-1 min-w-[130px]">
        <label class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">Status</label>
        <select class="w-full p-2 bg-card border-2 border-border rounded-lg text-foreground text-xs font-mono font-bold shadow-neo-sm focus:outline-none focus:ring-2 focus:ring-[#A6FA53]"
                value="@_filterStatus" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Not Marked">Not Marked</option>
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
            <option value="Cancelled">Cancelled</option>
            <option value="Holiday">Holiday</option>
        </select>
    </div>

    <div class="flex flex-col gap-1.5 flex-1 min-w-[140px]">
        <label class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">From</label>
        <DatePicker Value="_filterStartDate" ValueChanged="OnStartDateChanged" />
    </div>

    <div class="flex flex-col gap-1.5 flex-1 min-w-[140px]">
        <label class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">To</label>
        <DatePicker Value="_filterEndDate" ValueChanged="OnEndDateChanged" AlignRight="true" />
    </div>
</div>

<!-- Toast Message -->
@if (!string.IsNullOrEmpty(_message))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-xs font-mono font-bold border-2 border-black shadow-neo-sm animate-in fade-in slide-in-from-top duration-300 @(_isError ? "bg-[#FF6B6B]/20 text-[#FF6B6B]" : "bg-[#A6FA53]/20 text-[#A6FA53]")">
        @_message
        <button class="float-right text-current opacity-70 hover:opacity-100 transition-opacity ml-3 font-black cursor-pointer" @onclick='() => _message = ""'>×</button>
    </div>
}

<!-- Loading State -->
@if (_isLoading)
{
    <div class="flex items-center justify-center py-20 font-mono">
        <div class="flex flex-col items-center gap-4">
            <div class="w-8 h-8 border-4 border-[#A6FA53] border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs text-muted-foreground font-bold">Loading sessions...</p>
        </div>
    </div>
}
else if (_sessions == null || !_sessions.Any())
{
    <div class="flex flex-col items-center justify-center py-20 text-center font-mono">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-muted-foreground/40 mb-4"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 11 3 3 5-5"/></svg>
        <h3 class="text-sm font-black text-foreground mb-1 font-sans">No sessions found</h3>
        <p class="text-xs text-muted-foreground">Try adjusting your filters or generate sessions first.</p>
    </div>
}
else
{
    @if (_selectedIds.Any())
    {
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-4 mb-4 bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo animate-in slide-in-from-top duration-200 gap-3 font-mono">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#A6FA53] border border-black shadow-neo-sm"></span>
                <span class="text-xs font-bold text-foreground">@_selectedIds.Count session(s) selected</span>
            </div>
            <div class="flex items-center flex-wrap gap-2">
                <button class="px-3 py-1.5 rounded-lg text-xs font-black transition-all bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 cursor-pointer"
                        @onclick='() => RequestBulkStatusChange("Present")'>
                    Present
                </button>
                <button class="px-3 py-1.5 rounded-lg text-xs font-black transition-all bg-[#FF6B6B] text-black border-2 border-black shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 cursor-pointer"
                        @onclick='() => RequestBulkStatusChange("Absent")'>
                    Absent
                </button>
                <button class="px-3 py-1.5 rounded-lg text-xs font-black transition-all bg-[#FFD026] text-black border-2 border-black shadow-neo-sm hover:-translate-x-0.5 hover:-translate-y-0.5 cursor-pointer"
                        @onclick='() => RequestBulkStatusChange("Cancelled")'>
                    Cancelled
                </button>
                <button class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-card text-foreground border-2 border-border shadow-neo-sm hover:bg-muted cursor-pointer"
                        @onclick='() => RequestBulkStatusChange("Not Marked")'>
                    Not Marked
                </button>
                <span class="h-4 w-px bg-border mx-1 hidden sm:inline"></span>
                <button class="text-xs text-muted-foreground hover:text-foreground font-bold transition-colors underline cursor-pointer" @onclick="ClearSelection">
                    Clear
                </button>
            </div>
        </div>
    }

    <!-- Sessions Table -->
    <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs font-mono">
                <thead>
                    <tr class="border-b-2 border-black dark:border-zinc-700 bg-muted/40">
                        <th class="px-4 py-3.5 w-10">
                            <input type="checkbox" class="w-4 h-4 rounded-sm border-2 border-black accent-black cursor-pointer shadow-neo-sm"
                                   checked="@_isAllSelected" @onchange="ToggleSelectAll" />
                        </th>
                        <th class="px-4 py-3.5 font-bold uppercase tracking-wider text-center text-foreground">Date</th>
                        <th class="px-4 py-3.5 font-bold uppercase tracking-wider text-foreground">Module</th>
                        <th class="px-4 py-3.5 font-bold uppercase tracking-wider text-foreground">Time</th>
                        <th class="px-4 py-3.5 font-bold uppercase tracking-wider text-center text-foreground">Status</th>
                        <th class="px-4 py-3.5 w-12 text-center"></th>
                    </tr>
                </thead>
                <tbody class="divide-y-2 divide-border/60">
                    @foreach (var session in _sessions)
                    {
                        var isSelected = _selectedIds.Contains(session.Id);
                        <tr class="transition-colors @(isSelected ? "bg-[#A6FA53]/15 border-l-4 border-l-[#A6FA53]" : "hover:bg-[#A6FA53]/10")">
                            <td class="px-4 py-3.5">
                                <input type="checkbox" class="w-4 h-4 rounded-sm border-2 border-black accent-black cursor-pointer shadow-neo-sm"
                                       checked="@isSelected" @onchange="() => ToggleSelection(session.Id)" />
                            </td>
                            <td class="px-4 py-3.5 text-center">
                                <span class="font-bold text-foreground text-xs font-mono">@session.SessionDate.ToString("dd-MM-yy")</span>
                            </td>
                            <td class="px-4 py-3.5">
                                <div class="font-bold text-foreground text-sm font-sans">@session.ModuleName</div>
                                <div class="text-[10px] text-muted-foreground font-mono font-bold mt-0.5">@session.ModuleCode</div>
                            </td>
                            <td class="px-4 py-3.5 font-mono text-xs text-muted-foreground font-bold">
                                @((session.StartDatetime + MyanmarOffset).ToString("hh:mm tt")) – @((session.EndDatetime + MyanmarOffset).ToString("hh:mm tt"))
                            </td>
                            <td class="px-4 py-3.5 text-center">
                                <span class="px-3 py-1 rounded-md text-xs font-black font-mono border-2 @GetBadgeClass(session.Status)">
                                    @session.Status
                                </span>
                            </td>
                            <td class="px-4 py-3.5 text-center">
                                <button id="btn-@session.Id" class="p-1.5 rounded-lg border-2 border-transparent hover:border-black hover:bg-[#FFD026] text-muted-foreground hover:text-black transition-all cursor-pointer focus:outline-none"
                                        @onclick="() => ToggleDropdown(session)" @onclick:stopPropagation>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-more-vertical"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (_totalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between border-t-2 border-border px-4 py-3 bg-muted/20">
                <span class="text-xs text-muted-foreground font-mono font-bold mb-2 sm:mb-0">
                    Page @_pageNumber of @_totalPages (@_totalCount sessions)
                </span>
                <PaginationControl PageNumber="_pageNumber" TotalPages="_totalPages" PageChanged="OnPageChanged" />
            </div>
        }
    </div>
}

<!-- Floating Status Dropdown Menu (Escapes container clipping) -->
@if (_openDropdownSessionId != null && _buttonRect != null)
{
    <div class="fixed inset-0 z-40 bg-transparent" @onclick="CloseDropdown"></div>
    <div class="fixed bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo-xl z-50 py-1.5 text-left font-mono animate-in fade-in duration-100 min-w-[140px]" 
         style="@GetDropdownStyle()" @onclick:stopPropagation>
        <button class="w-full px-3 py-2 text-xs font-black flex items-center gap-2 hover:bg-[#A6FA53] hover:text-black text-[#A6FA53] transition-colors cursor-pointer"
                @onclick='() => ChangeStatusDirectly("Present")'>
            <span class="w-2.5 h-2.5 rounded-full bg-[#A6FA53] border border-black shadow-neo-sm"></span> Present
        </button>
        <button class="w-full px-3 py-2 text-xs font-black flex items-center gap-2 hover:bg-[#FF6B6B] hover:text-black text-[#FF6B6B] transition-colors cursor-pointer"
                @onclick='() => ChangeStatusDirectly("Absent")'>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B6B] border border-black shadow-neo-sm"></span> Absent
        </button>
        <button class="w-full px-3 py-2 text-xs font-black flex items-center gap-2 hover:bg-[#FFD026] hover:text-black text-[#FFD026] transition-colors cursor-pointer"
                @onclick='() => ChangeStatusDirectly("Cancelled")'>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FFD026] border border-black shadow-neo-sm"></span> Cancelled
        </button>
        <button class="w-full px-3 py-2 text-xs font-bold flex items-center gap-2 hover:bg-muted text-muted-foreground transition-colors cursor-pointer"
                @onclick='() => ChangeStatusDirectly("Not Marked")'>
            <span class="w-2.5 h-2.5 rounded-full bg-muted-foreground border border-black"></span> Not Marked
        </button>
    </div>
}

<!-- Single Status Confirm Modal -->
@if (_showSingleConfirmModal)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-[150] animate-in fade-in duration-200">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 max-w-sm w-full shadow-neo-xl animate-in zoom-in duration-200">
            <h3 class="text-lg font-black text-foreground mb-2 font-sans">Confirm Status Change</h3>
            <p class="text-xs text-muted-foreground font-mono mb-6">
                Are you sure you want to change this session to <span class="font-bold text-foreground underline">@_pendingStatus</span>?
            </p>
            <div class="flex justify-end gap-3 font-mono">
                <button type="button"
                        class="neo-btn px-4 py-2 bg-card hover:bg-muted text-foreground border-2 border-border rounded-xl text-xs font-bold shadow-neo-sm cursor-pointer"
                        @onclick="CancelConfirm">
                    Cancel
                </button>
                <button type="button"
                        class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo cursor-pointer"
                        @onclick="ConfirmSingleStatusChange">
                    Yes, Change
                </button>
            </div>
        </div>
    </div>
}

<!-- Bulk Status Confirm Modal -->
@if (_showBulkConfirmModal)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-[150] animate-in fade-in duration-200">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 max-w-md w-full shadow-neo-xl animate-in zoom-in duration-200">
            <h3 class="text-lg font-black text-foreground mb-2 font-sans">Bulk Status Update</h3>
            <p class="text-xs text-muted-foreground font-mono mb-4">
                You are about to change the status of <span class="font-bold text-foreground underline">@_selectedIds.Count session(s)</span> to:
            </p>
            <div class="flex items-center gap-2.5 mb-6 p-3 bg-muted/30 border-2 border-border rounded-xl">
                <span class="px-3 py-1 rounded-md text-xs font-black font-mono border-2 @GetBadgeClass(_pendingStatus)">@_pendingStatus</span>
                <span class="text-xs text-muted-foreground font-mono">→ Applied to all selected sessions</span>
            </div>
            <div class="flex justify-end gap-3 font-mono">
                <button type="button"
                        class="neo-btn px-4 py-2 bg-card hover:bg-muted text-foreground border-2 border-border rounded-xl text-xs font-bold shadow-neo-sm cursor-pointer"
                        @onclick="CancelConfirm">
                    Cancel
                </button>
                <button type="button"
                        class="neo-btn-primary px-4 py-2 rounded-xl text-xs font-black shadow-neo cursor-pointer"
                        @onclick="ConfirmBulkStatusChange">
                    Yes, Update All
                </button>
            </div>
        </div>
    </div>
}

<!-- Updating Overlay -->
@if (_isUpdating)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex flex-col items-center justify-center z-[200] animate-in fade-in duration-200">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 flex flex-col items-center gap-4 shadow-neo-xl max-w-xs text-center animate-in zoom-in duration-200">
            <div class="w-10 h-10 border-4 border-[#A6FA53] border-t-transparent rounded-full animate-spin"></div>
            <div>
                <h4 class="text-sm font-black text-foreground font-sans">Updating Attendance</h4>
                <p class="text-xs text-muted-foreground font-mono mt-1">
                    @if (_selectedIds.Count > 1)
                    {
                        <span>Updating @_updateProgress of @_updateTotal sessions...</span>
                    }
                    else
                    {
                        <span>Please wait while we update the session status...</span>
                    }
                </p>
            </div>
        </div>
    </div>
}

@code {
    private static readonly TimeSpan MyanmarOffset = TimeSpan.FromHours(6.5);

    // State
    private List<ClassSessionDto>? _sessions;
    private List<SemesterDto>? _semesters;
    private List<ModuleDto>? _modules;
    private bool _isLoading = true;
    private bool _isUpdating = false;
    private string _message = string.Empty;
    private bool _isError = false;

    // Selection
    private HashSet<long> _selectedIds = new();
    private bool _isAllSelected = false;

    // Filters
    private long? _selectedSemesterId;
    private long? _selectedModuleId;
    private string _filterStatus = "Not Marked";

    private DateOnly _filterStartDate;
    private DateOnly _filterEndDate;

    // Pagination
    private int _pageNumber = 1;
    private int _pageSize = 20;
    private int _totalPages = 1;
    private int _totalCount = 0;
    private bool _hasPrevious = false;
    private bool _hasNext = false;

    // Confirm modals
    private bool _showSingleConfirmModal = false;
    private bool _showBulkConfirmModal = false;
    private long _pendingSessionId;
    private string _pendingStatus = string.Empty;
    private long? _openDropdownSessionId;
    private ElementRect? _buttonRect;

    public class ElementRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Right { get; set; }
        public double Bottom { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    // Progress tracking
    private int _updateProgress = 0;
    private int _updateTotal = 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSemesters(), LoadModules());

        var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(6.5));
        _filterStartDate = today;
        _filterEndDate = today;

        // Auto-select current semester
        if (_semesters != null && _semesters.Any())
        {
            var current = _semesters.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
                          ?? _semesters.OrderByDescending(s => s.StartDate).First();
            _selectedSemesterId = current.Id;
        }

        await LoadSessions();
    }

    // --- Data Loading ---

    private async Task LoadSemesters()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<SemesterDto>>("api/semesters");
            if (result?.IsSuccess == true && result.Data != null)
            {
                _semesters = result.Data;
            }
        }
        catch { }
    }

    private async Task LoadModules()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<ModuleDto>>("api/modules");
            if (result?.IsSuccess == true && result.Data != null)
            {
                _modules = result.Data;
            }
        }
        catch { }
    }

    private async Task LoadSessions()
    {
        _isLoading = true;
        _selectedIds.Clear();
        _isAllSelected = false;
        try
        {
            var query = new List<string>();
            if (_selectedSemesterId.HasValue) query.Add($"semesterId={_selectedSemesterId}");
            if (_selectedModuleId.HasValue) query.Add($"moduleId={_selectedModuleId}");
            if (!string.IsNullOrEmpty(_filterStatus)) query.Add($"status={Uri.EscapeDataString(_filterStatus)}");

            if (_filterStartDate != default) query.Add($"startDate={_filterStartDate:yyyy-MM-dd}");
            if (_filterEndDate != default) query.Add($"endDate={_filterEndDate:yyyy-MM-dd}");
            query.Add($"pageNumber={_pageNumber}");
            query.Add($"pageSize={_pageSize}");

            var queryString = query.Any() ? "?" + string.Join("&", query) : "";
            var result = await Http.GetFromJsonAsync<PagedResult<ClassSessionDto>>($"api/classsessions{queryString}");
            if (result != null && result.IsSuccess)
            {
                _sessions = result.Data;
                if (result.Pagination != null)
                {
                    _totalPages = result.Pagination.TotalPages;
                    _totalCount = result.Pagination.TotalCount;
                    _hasPrevious = result.Pagination.HasPreviousPage;
                    _hasNext = result.Pagination.HasNextPage;
                }
            }
        }
        catch (Exception ex)
        {
            _message = ex.GetFriendlyErrorMessage("Error loading sessions");
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // --- Filter Handlers ---

    private async Task OnSemesterChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedSemesterId = id;
        }
        _pageNumber = 1;
        await LoadSessions();
    }

    private async Task OnModuleChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedModuleId = long.TryParse(val, out var id) ? id : null;
        _pageNumber = 1;
        await LoadSessions();
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        _filterStatus = e.Value?.ToString() ?? "";
        _pageNumber = 1;
        await LoadSessions();
    }



    private async Task OnStartDateChanged(DateOnly date)
    {
        _filterStartDate = date;
        _pageNumber = 1;
        await LoadSessions();
    }

    private async Task OnEndDateChanged(DateOnly date)
    {
        _filterEndDate = date;
        _pageNumber = 1;
        await LoadSessions();
    }

    // --- Selection ---

    private void ToggleSelection(long id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);

        _isAllSelected = _sessions != null && _sessions.All(s => _selectedIds.Contains(s.Id));
    }

    private void ToggleSelectAll()
    {
        if (_sessions == null) return;

        if (_isAllSelected)
        {
            foreach (var s in _sessions)
                _selectedIds.Remove(s.Id);
            _isAllSelected = false;
        }
        else
        {
            foreach (var s in _sessions)
                _selectedIds.Add(s.Id);
            _isAllSelected = true;
        }
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _isAllSelected = false;
    }

    // --- Single Status Change ---

    private void RequestSingleStatusChange(long sessionId, string status)
    {
        _pendingSessionId = sessionId;
        _pendingStatus = status;
        _showSingleConfirmModal = true;
    }

    private async Task ConfirmSingleStatusChange()
    {
        _showSingleConfirmModal = false;
        _isUpdating = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/classsessions/{_pendingSessionId}/status", new { Status = _pendingStatus });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResult>();
                if (result != null && result.IsSuccess)
                {
                    // Update local state without full reload
                    var session = _sessions?.FirstOrDefault(s => s.Id == _pendingSessionId);
                    if (session != null)
                    {
                        session.Status = _pendingStatus;
                    }
                    _message = "Status updated successfully.";
                    _isError = false;
                }
                else
                {
                    _message = result?.Message ?? "Failed to update status.";
                    _isError = true;
                }
            }
            else
            {
                _message = await response.GetFriendlyErrorMessageAsync("Error updating status");
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = ex.GetFriendlyErrorMessage("Error updating status");
            _isError = true;
        }
        finally
        {
            _isUpdating = false;
        }
    }

    // --- Bulk Status Change ---

    private void RequestBulkStatusChange(string status)
    {
        _pendingStatus = status;
        _showBulkConfirmModal = true;
    }

    private async Task ConfirmBulkStatusChange()
    {
        _showBulkConfirmModal = false;
        _isUpdating = true;
        _updateTotal = _selectedIds.Count;
        _updateProgress = 0;

        try
        {
            var request = new BulkUpdateSessionStatusRequest
            {
                SessionIds = _selectedIds.ToList(),
                Status = _pendingStatus
            };

            var response = await Http.PatchAsJsonAsync("api/classsessions/bulk-status", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResult>();
                if (result != null && result.IsSuccess)
                {
                    if (_sessions != null)
                    {
                        foreach (var session in _sessions)
                        {
                            if (_selectedIds.Contains(session.Id))
                            {
                                session.Status = _pendingStatus;
                            }
                        }
                    }
                    _message = $"Successfully updated {_selectedIds.Count} session(s) to {_pendingStatus}.";
                    _isError = false;
                }
                else
                {
                    _message = result?.Message ?? "Failed to update status.";
                    _isError = true;
                }
            }
            else
            {
                _message = await response.GetFriendlyErrorMessageAsync("Error updating status");
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = ex.GetFriendlyErrorMessage("Error updating status");
            _isError = true;
        }
        finally
        {
            _selectedIds.Clear();
            _isAllSelected = false;
            _isUpdating = false;
        }
    }

    private void CancelConfirm()
    {
        _showSingleConfirmModal = false;
        _showBulkConfirmModal = false;
    }

    private async Task ToggleDropdown(ClassSessionDto session)
    {
        if (_openDropdownSessionId == session.Id)
        {
            CloseDropdown();
        }
        else
        {
            _buttonRect = await JSRuntime.InvokeAsync<ElementRect>("getButtonPosition", $"btn-{session.Id}");
            _openDropdownSessionId = session.Id;
        }
    }

    private void CloseDropdown()
    {
        _openDropdownSessionId = null;
        _buttonRect = null;
    }

    private string GetDropdownStyle()
    {
        if (_buttonRect == null) return "display: none;";
        double left = _buttonRect.Right - 144;
        double top = _buttonRect.Bottom + 4;
        return $"position: fixed; left: {left}px; top: {top}px; width: 144px; z-index: 150;";
    }

    private async Task ChangeStatusDirectly(string status)
    {
        if (_openDropdownSessionId == null) return;
        
        var sessionId = _openDropdownSessionId.Value;
        CloseDropdown();
        
        _isUpdating = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/classsessions/{sessionId}/status", new { Status = status });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResult>();
                if (result != null && result.IsSuccess)
                {
                    var session = _sessions?.FirstOrDefault(s => s.Id == sessionId);
                    if (session != null)
                    {
                        session.Status = status;
                    }
                    _message = "Status updated successfully.";
                    _isError = false;
                }
                else
                {
                    _message = result?.Message ?? "Failed to update status.";
                    _isError = true;
                }
            }
            else
            {
                _message = await response.GetFriendlyErrorMessageAsync("Error updating status");
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = ex.GetFriendlyErrorMessage("Error updating status");
            _isError = true;
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    // --- Pagination ---

    private async Task OnPageChanged(int newPage)
    {
        if (newPage >= 1 && newPage <= _totalPages && newPage != _pageNumber)
        {
            _pageNumber = newPage;
            await LoadSessions();
        }
    }

    private async Task GoToPreviousPage()
    {
        if (_pageNumber > 1)
        {
            _pageNumber--;
            await LoadSessions();
        }
    }

    private async Task GoToNextPage()
    {
        if (_pageNumber < _totalPages)
        {
            _pageNumber++;
            await LoadSessions();
        }
    }

    // --- Helpers ---


    private string GetBadgeClass(string status) => status switch
    {
        "Present" => "bg-[#A6FA53] text-black font-black font-mono border-2 border-black shadow-neo-sm",
        "Absent" => "bg-[#FF6B6B] text-black font-black font-mono border-2 border-black shadow-neo-sm",
        "Cancelled" => "bg-[#FFD026] text-black font-black font-mono border-2 border-black shadow-neo-sm",
        "Holiday" => "bg-[#C084FC] text-black font-black font-mono border-2 border-black shadow-neo-sm",
        "Not Marked" => "bg-card text-foreground font-bold font-mono border-2 border-border shadow-neo-sm",
        _ => "bg-muted text-foreground font-bold font-mono border-2 border-border"
    };
}
