                        <div class="h-3 bg-muted rounded w-10 mx-auto"></div>
                    </div>
                }
            </div>
        </div>
    };

    private int GetWeeklyTotalPages()
    {
        if (_summary?.WeeklyAttendance == null || !_summary.WeeklyAttendance.Any()) return 1;
        return (int)Math.Ceiling((double)_summary.WeeklyAttendance.Count / _weeklyPageSize);
    }

    private void OnWeeklyPageChanged(int page)
    {
        _weeklyPageNumber = page;
    }

    private void BuildMonthFilterOptions()
    {
        _availableMonths = new List<MonthFilterOption>
        {
            new() { Value = "all", Text = "All Months" }
        };

        if (_summary != null)
        {
            var current = new DateOnly(_summary.StartDate.Year, _summary.StartDate.Month, 1);
            var end = new DateOnly(_summary.EndDate.Year, _summary.EndDate.Month, 1);

            int limit = 0;
            while (current <= end && limit < 100)
            {
                var text = current.ToString("MMMM yyyy");
                var val = current.Month.ToString();
                _availableMonths.Add(new MonthFilterOption
                {
                    Value = val,
                    Text = text,
                    Month = current.Month
                });
                current = current.AddMonths(1);
                limit++;
            }
        }
    }

    private async Task OnMonthFilterChanged(string monthVal)
    {
        _selectedMonthFilter = string.IsNullOrEmpty(monthVal) ? "all" : monthVal;
        
        _isLoadingDailyWeekly = true;
        _isLoadingModules = true;
        StateHasChanged();

        int? month = null;
        if (_selectedMonthFilter != "all" && int.TryParse(_selectedMonthFilter, out int m))
        {
            month = m;
        }

        await Task.WhenAll(
            LoadDailyWeeklyBreakdown(_selectedSemesterId, month),
            LoadModulesBreakdown(_selectedSemesterId, month)
        );
    }

    private bool HasDataForSelectedFilter()
    {
        if (_summary == null) return false;
        
        if (_activeTab == Tab.Daily)
        {
            return _summary.DailyAttendance != null && _summary.DailyAttendance.Any(d => d.TotalSessions > 0);
        }
        if (_activeTab == Tab.Weekly)
        {
            return _summary.WeeklyAttendance != null && _summary.WeeklyAttendance.Any(w => w.TotalSessions > 0);
        }
        if (_activeTab == Tab.Monthly)
        {
            return _summary.MonthlyAttendance != null && _summary.MonthlyAttendance.Any(m => m.TotalSessions > 0);
        }
        if (_activeTab == Tab.Module)
        {
            return _summary.ModuleAttendance != null && _summary.ModuleAttendance.Any(m => m.TotalSessions > 0);
        }
        return false;
    }

    private string GetSelectedMonthName()
    {
        if (_selectedMonthFilter == "all") return "this semester";
        var option = _availableMonths.FirstOrDefault(o => o.Value == _selectedMonthFilter);
        return option != null ? option.Text : "the selected month";
    }
}
