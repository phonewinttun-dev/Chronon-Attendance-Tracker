@page "/dashboard"
@using ACST.WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

@if (_isLoadingSemesters)
{
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 animate-pulse">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-foreground">Dashboard</h1>
                <div class="h-5 bg-muted rounded-full w-28"></div>
            </div>
            <div class="h-4 bg-muted rounded w-64 mt-2"></div>
        </div>
        <div class="flex items-center gap-3">
            <div class="h-4 bg-muted rounded w-16"></div>
            <div class="h-9 bg-muted rounded w-[220px]"></div>
        </div>
    </div>
    @RenderDashboardSkeletons
}
else if (_isError)
{
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-foreground">Dashboard</h1>
            </div>
        </div>
    </div>
    @RenderDashboardSkeletons

    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-50">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-8 max-w-sm w-full shadow-neo-xl text-center animate-in zoom-in duration-200">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-xl bg-[#FF6B6B] text-black border-2 border-black shadow-neo-sm mb-4">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h3 class="text-lg font-black text-foreground mb-2 font-sans">Unexpected Error Occurred</h3>
            <p class="text-xs text-muted-foreground mb-6 leading-relaxed font-mono">Failed to connect to the server or load required data. Please check your connection and try again.</p>
            <button class="neo-btn-destructive w-full py-2.5 rounded-xl text-xs font-black shadow-neo"
                    @onclick="LoadInitialData">
                Refresh
            </button>
        </div>
    </div>
}
else if (_semesters == null || !_semesters.Any())
{
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-black tracking-tight text-foreground font-sans">Dashboard</h1>
    </div>
    <div class="border-2 border-black dark:border-zinc-700 p-8 rounded-2xl text-center max-w-md mx-auto my-12 bg-card shadow-neo">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-xl bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
        </div>
        <h3 class="font-black text-lg mb-2 text-foreground font-sans">No Semesters Found</h3>
        <p class="text-muted-foreground text-xs font-mono mb-6">Please create a semester first to view dashboard analytics.</p>
        <button class="neo-btn-primary px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider shadow-neo"
                @onclick='() => Navigation.NavigateTo("/semesters")'>
            Create A Semester
        </button>
    </div>
}
else
{
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-black tracking-tight text-foreground font-sans">Dashboard</h1>
                @if (_selectedSemesterId == _currentSemesterId)
                {
                    <span class="bg-[#A6FA53] text-black border-2 border-black px-3 py-0.5 rounded-md text-xs font-mono font-bold shadow-neo-sm">Current Semester</span>
                }
                else
                {
                    <span class="bg-[#FFD026] text-black border-2 border-black px-3 py-0.5 rounded-md text-xs font-mono font-bold shadow-neo-sm">Previous Semester</span>
                }
            </div>
            @if (_summary != null)
            {
                <p class="text-muted-foreground text-xs font-mono mt-1">
                    Academic Period: <span class="font-bold text-foreground">@_summary.StartDate.ToString("dd-MM-yyyy")</span> to <span class="font-bold text-foreground">@_summary.EndDate.ToString("dd-MM-yyyy")</span>
                </p>
            }
        </div>
        <div class="flex items-center gap-3">
            <label class="text-muted-foreground font-mono font-bold text-xs uppercase whitespace-nowrap">Semester:</label>
            <CustomSelect TValue="long"
                          Value="_selectedSemesterId"
                          ValueChanged="OnSemesterChanged"
                          Class="min-w-[220px]">
                @foreach (var sem in _semesters)
                {
                    <CustomSelectOption TValue="long" Value="@sem.Id" Text="@sem.Name" />
                }
            </CustomSelect>
        </div>
    </div>

    @if (_isLoadingSummary)
    {
        @RenderDashboardSkeletons
    }
    else if (_summary == null)
    {
        <div class="bg-card border border-destructive/50 p-6 rounded-lg text-destructive text-sm font-semibold">
            Failed to load dashboard data for the selected semester.
        </div>
    }
    else
    {
        <!-- Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all">
                <h3 class="text-muted-foreground text-xs font-mono font-bold uppercase tracking-wider mb-2">Today's Classes</h3>
                <div class="text-4xl font-black text-foreground font-mono">
                    @_summary.TodaySessionsCount
                </div>
            </div>

            <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all cursor-pointer" @onclick='() => Navigation.NavigateTo("/calendar")'>
                <h3 class="text-muted-foreground text-xs font-mono font-bold uppercase tracking-wider mb-2">Upcoming (7 days)</h3>
                <div class="text-4xl font-black text-foreground font-mono">
                    @_summary.UpcomingSessionsCount
                </div>
            </div>

            <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all cursor-pointer relative overflow-hidden" @onclick="() => SetActiveTab(Tab.Module)">
                <h3 class="text-muted-foreground text-xs font-mono font-bold uppercase tracking-wider mb-2">Semester Attendance</h3>
                <div class="text-4xl font-black font-mono @GetHealthColorClass(_summary.SemesterHealthRate)">
                    @_summary.SemesterHealthRate%
                </div>
                <div class="text-xs text-muted-foreground mt-2 font-mono">
                    Total Classes: <span class="font-bold text-foreground">@_summary.TotalSessions</span>
                </div>
            </div>

            <div class="bg-card border-2 border-black dark:border-zinc-700 p-6 rounded-xl shadow-neo hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all cursor-pointer relative overflow-hidden" @onclick="() => SetActiveTab(Tab.Daily)">
                <h3 class="text-muted-foreground text-xs font-mono font-bold uppercase tracking-wider mb-2">Today's Attendance</h3>
                <div class="text-4xl font-black font-mono @GetHealthColorClass(_summary.TodayAttendanceRate ?? 0)">
                    @(_summary.TodayAttendanceRate ?? 0)%
                </div>
            </div>
        </div>

        @if (_summary.Warnings.Any())
        {
            <div class="bg-card border-2 border-black dark:border-[#FF6B6B] p-5 rounded-xl shadow-neo mb-8">
                <h3 class="text-[#FF6B6B] font-black text-sm mb-2 flex items-center gap-2 font-sans">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#FF6B6B] shrink-0 lucide lucide-triangle-alert">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    Alerts
                </h3>
                <ul class="list-disc pl-5 text-foreground text-xs space-y-1 font-mono font-bold">
                    @foreach (var warning in _summary.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }


        <!-- Daily, Weekly, Monthly Tabs -->
        <div id="attendance-breakdown" class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl shadow-neo-lg overflow-hidden mb-8">
            <div class="border-b-2 border-border bg-muted/40 flex flex-col md:flex-row md:items-center justify-between p-3 gap-3">
                <div class="flex flex-wrap gap-1.5 font-mono">
                    <button class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition-all cursor-pointer @(_activeTab == Tab.Daily ? "bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm font-black" : "border-2 border-transparent text-muted-foreground hover:bg-[#FFD026] hover:text-black hover:border-black")"
                            @onclick="() => SetActiveTab(Tab.Daily)">
                        Daily
                    </button>
                    <button class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition-all cursor-pointer @(_activeTab == Tab.Weekly ? "bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm font-black" : "border-2 border-transparent text-muted-foreground hover:bg-[#FFD026] hover:text-black hover:border-black")"
                            @onclick="() => SetActiveTab(Tab.Weekly)">
                        Weekly
                    </button>
                    <button class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition-all cursor-pointer @(_activeTab == Tab.Monthly ? "bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm font-black" : "border-2 border-transparent text-muted-foreground hover:bg-[#FFD026] hover:text-black hover:border-black")"
                            @onclick="() => SetActiveTab(Tab.Monthly)">
                        Monthly
                    </button>
                    <button class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition-all cursor-pointer @(_activeTab == Tab.Module ? "bg-[#A6FA53] text-black border-2 border-black shadow-neo-sm font-black" : "border-2 border-transparent text-muted-foreground hover:bg-[#FFD026] hover:text-black hover:border-black")"
                            @onclick="() => SetActiveTab(Tab.Module)">
                        By Module
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 mr-1 font-mono">
                    <!-- Semester dropdown in card header -->
                    <div class="flex items-center gap-1.5">
                        <span class="text-muted-foreground text-xs font-bold uppercase whitespace-nowrap">Sem:</span>
                        <CustomSelect TValue="long"
                                      Value="_selectedSemesterId"
                                      ValueChanged="OnSemesterChanged"
                                      Size="sm"
                                      Class="min-w-[140px]">
                            @foreach (var sem in _semesters)
                            {
                                <CustomSelectOption TValue="long" Value="@sem.Id" Text="@sem.Name" />
                            }
                        </CustomSelect>
                    </div>

                    <!-- Month dropdown in card header -->
                    <div class="flex items-center gap-1.5">
                        <span class="text-muted-foreground text-xs font-bold uppercase whitespace-nowrap">Month:</span>
                        <CustomSelect TValue="string"
                                      Value="_selectedMonthFilter"
                                      ValueChanged="OnMonthFilterChanged"
                                      Size="sm"
                                      Class="min-w-[130px]">
                            @foreach (var opt in _availableMonths)
                            {
                                <CustomSelectOption TValue="string" Value="@opt.Value" Text="@opt.Text" />
                            }
                        </CustomSelect>
                    </div>

                    <div class="flex items-center gap-1 bg-card border-2 border-border p-0.5 rounded-lg shadow-neo-sm">
                        <button class="p-1.5 rounded-md transition-all cursor-pointer @(_breakdownViewMode == "table" ? "bg-[#FFD026] text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")" 
                                @onclick='() => _breakdownViewMode = "table"' 
                                title="Table View">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
                        </button>
                        <button class="p-1.5 rounded-md transition-all cursor-pointer @(_breakdownViewMode == "card" ? "bg-[#FFD026] text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")" 
                                @onclick='() => _breakdownViewMode = "card"' 
                                title="Card View">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            <div class="p-6">
                @if (_activeTab == Tab.Daily && _isLoadingDailyWeekly)
                {
                    <div class="flex justify-center items-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                    </div>
                }
                else if (_activeTab == Tab.Weekly && _isLoadingDailyWeekly)
                {
                    <div class="flex justify-center items-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                    </div>
                }
                else if (_activeTab == Tab.Monthly && _isLoadingDailyWeekly)
                {
                    <div class="flex justify-center items-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                    </div>
                }
                else if (_activeTab == Tab.Module && _isLoadingModules)
                {
                    <div class="flex justify-center items-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                    </div>
                }
                else if (!HasDataForSelectedFilter())
                {
                    <div class="flex flex-col items-center justify-center p-8 bg-card border border-dashed border-border rounded-lg text-center my-6">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-muted-foreground/60 mb-3">
                            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                        </svg>
                        <h3 class="text-sm font-semibold text-foreground mb-1">No Class Sessions Recorded</h3>
                        <p class="text-xs text-muted-foreground max-w-sm">
                            No class sessions have been scheduled or recorded for @GetSelectedMonthName() yet. Try choosing a different month or adjust your filters.
                        </p>
                    </div>
                }
                else
                {
                    @if (_activeTab == Tab.Daily)
                    {
                        @if (_breakdownViewMode == "table")
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse text-xs font-mono">
                                    <thead class="bg-muted/40 border-b-2 border-black dark:border-zinc-700">
                                        <tr>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-foreground">Day of Week</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-foreground">Total</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-[#A6FA53]">Present</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-[#FF6B6B]">Absent</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Not Marked</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Cancelled</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Holiday</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-right text-foreground">Attendance Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y-2 divide-border/60">
                                        @foreach (var day in _summary.DailyAttendance)
                                        {
                                            <tr class="hover:bg-[#A6FA53]/10 transition-colors cursor-pointer" @onclick="() => NavigateToDaily(day.DayOfWeek)">
                                                <td class="px-4 py-3.5 font-sans text-sm font-bold text-foreground">@day.DayOfWeek</td>
                                                <td class="px-4 py-3.5 text-center font-bold text-foreground">@day.TotalSessions</td>
                                                <td class="px-4 py-3.5 text-center text-[#A6FA53] font-black">@day.Present</td>
                                                <td class="px-4 py-3.5 text-center text-[#FF6B6B] font-black">@day.Absent</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@day.NotMarked</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@day.Cancelled</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@day.Holiday</td>
                                                <td class="px-4 py-3.5 text-right">
                                                    <span class="px-3 py-1 rounded-md text-xs font-black font-mono border-2 @GetBadgeBorderAndBg(day.AttendanceRate)">
                                                        @day.AttendanceRate%
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var day in _summary.DailyAttendance)
                                {
                                    <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-xl p-5 flex flex-col justify-between hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-neo transition-all shadow-neo-sm cursor-pointer" @onclick="() => NavigateToDaily(day.DayOfWeek)">
                                        <div class="flex items-center justify-between mb-3">
                                            <h3 class="text-sm font-black text-foreground font-sans">@day.DayOfWeek</h3>
                                            <span class="px-2.5 py-0.5 rounded-md text-[11px] font-black font-mono border-2 @GetBadgeBorderAndBg(day.AttendanceRate)">
                                                @day.AttendanceRate%
                                            </span>
                                        </div>
                                        <div class="grid grid-cols-2 gap-y-1.5 gap-x-4 text-xs font-mono text-muted-foreground border-t-2 border-border/40 pt-3 font-bold">
                                            <div>Total: <span class="text-foreground font-black">@day.TotalSessions</span></div>
                                            <div>Present: <span class="text-[#A6FA53] font-black">@day.Present</span></div>
                                            <div>Absent: <span class="text-[#FF6B6B] font-black">@day.Absent</span></div>
                                            <div>Not Marked: <span class="text-foreground">@day.NotMarked</span></div>
                                            <div>Cancelled: <span class="text-foreground">@day.Cancelled</span></div>
                                            <div>Holiday: <span class="text-foreground">@day.Holiday</span></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_activeTab == Tab.Weekly)
                    {
                        @if (_breakdownViewMode == "table")
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse text-xs font-mono">
                                    <thead class="bg-muted/40 border-b-2 border-black dark:border-zinc-700">
                                        <tr>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-foreground">Week</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-foreground">Date Range</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-foreground">Total</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-[#A6FA53]">Present</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-[#FF6B6B]">Absent</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Not Marked</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Cancelled</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-center text-muted-foreground">Holiday</th>
                                            <th class="px-4 py-3 font-bold uppercase tracking-wider text-right text-foreground">Attendance Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y-2 divide-border/60">
                                        @foreach (var week in _summary.WeeklyAttendance.Skip((_weeklyPageNumber - 1) * _weeklyPageSize).Take(_weeklyPageSize))
                                        {
                                            <tr class="hover:bg-[#A6FA53]/10 transition-colors cursor-pointer" @onclick="() => NavigateToWeekly(week.WeekStartDate, week.WeekEndDate)">
                                                <td class="px-4 py-3.5 font-sans text-sm font-bold text-foreground">Week @week.WeekNumber</td>
                                                <td class="px-4 py-3.5 font-mono text-xs text-muted-foreground font-bold">@week.WeekStartDate.ToString("dd-MM-yyyy") ~ @week.WeekEndDate.ToString("dd-MM-yyyy")</td>
                                                <td class="px-4 py-3.5 text-center font-bold text-foreground">@week.TotalSessions</td>
                                                <td class="px-4 py-3.5 text-center text-[#A6FA53] font-black">@week.Present</td>
                                                <td class="px-4 py-3.5 text-center text-[#FF6B6B] font-black">@week.Absent</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@week.NotMarked</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@week.Cancelled</td>
                                                <td class="px-4 py-3.5 text-center text-muted-foreground font-medium">@week.Holiday</td>
                                                <td class="px-4 py-3.5 text-right">
                                                    <span class="px-3 py-1 rounded-md text-xs font-black font-mono border-2 @GetBadgeBorderAndBg(week.AttendanceRate)">
                                                        @week.AttendanceRate%
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var week in _summary.WeeklyAttendance.Skip((_weeklyPageNumber - 1) * _weeklyPageSize).Take(_weeklyPageSize))
                                {
