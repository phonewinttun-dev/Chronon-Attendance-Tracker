@using ACST.WebApp.Models

<div class="w-full flex flex-col justify-between">
    @if (Items == null || !Items.Any())
    {
        <div class="flex flex-col items-center justify-center p-8 bg-card border border-dashed border-border rounded-lg text-center my-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-muted-foreground/60 mb-2">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
            </svg>
            <h4 class="text-xs font-semibold text-foreground mb-1">No Attendance Data Available</h4>
            <p class="text-[11px] text-muted-foreground max-w-xs font-mono">
                No class records found for this period.
            </p>
        </div>
    }
    else
    {
        <!-- Grid scale header -->
        <div class="relative w-full flex justify-between text-[10px] font-mono text-muted-foreground px-1 mb-2 border-b border-dashed border-border/40 pb-1">
            <span>0%</span>
            <span>25%</span>
            <span>50%</span>
            <span>75%</span>
            <span class="pr-14">100%</span>
        </div>

        <!-- Horizontal Bars Container -->
        <div class="relative w-full flex flex-col gap-2.5 py-1">
            @foreach (var item in Items)
            {
                var barWidthPct = Math.Min(Math.Max((item.Rate / 100.0) * 82.0, 8.0), 82.0);
                var isHovered = _hoveredItemName == item.Name;

                <div class="flex items-center gap-3 w-full group cursor-pointer relative"
                     @onmouseenter="() => _hoveredItemName = item.Name"
                     @onmouseleave="() => _hoveredItemName = null">
                    
                    <div class="flex-1 h-8 bg-muted/20 rounded-md relative flex items-center overflow-visible">
                        <!-- Dashed Grid Lines -->
                        <div class="absolute inset-0 flex justify-between pointer-events-none px-1">
                            <div class="w-px h-full border-r border-dashed border-border/20"></div>
                            <div class="w-px h-full border-r border-dashed border-border/20"></div>
                            <div class="w-px h-full border-r border-dashed border-border/20"></div>
                            <div class="w-px h-full border-r border-dashed border-border/20"></div>
                        </div>

                        <!-- Active Colored Bar -->
                        <div style="width: @(barWidthPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;" 
                             class="h-full @GetBarColorClass(item.Rate) border-2 border-black rounded-md shadow-neo-sm flex items-center justify-between px-3 transition-transform duration-200 shrink-0 relative z-10 @(isHovered ? "translate-x-1" : "")">
                            <!-- Inside Left Label (matches LabelList position="insideLeft") -->
                            <span class="text-xs font-mono font-black text-black tracking-tight truncate select-none">
                                @item.Name
                            </span>
                        </div>

                        <!-- Right Label (matches LabelList position="right") -->
                        <div class="ml-2.5 flex items-center gap-1.5 font-mono z-10 shrink-0">
                            <span class="text-xs font-black text-foreground">@item.Rate%</span>
                            <span class="text-[10px] text-muted-foreground hidden sm:inline">(@item.Present/@item.TotalSessions)</span>
                        </div>

                        <!-- Hover Tooltip -->
                        @if (isHovered)
                        {
                            <div class="absolute right-14 -top-8 z-30 pointer-events-none bg-black text-white text-[10px] font-mono py-1 px-2.5 rounded border border-white/20 shadow-lg whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                @item.Name: @item.Present Present, @item.Absent Absent • Rate: @item.Rate%
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Card Footer -->
    <div class="border-t-2 border-border/30 pt-3 mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
        <div class="flex items-center gap-2 text-foreground font-bold">
            <svg class="w-4 h-4 text-[#A6FA53] shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>@TrendText</span>
        </div>
        <div class="text-muted-foreground text-[11px]">
            @FooterSummary
        </div>
    </div>
</div>

@code {
    public class HorizontalBarItem
    {
        public string Name { get; set; } = string.Empty;
        public double Rate { get; set; }
        public int Present { get; set; }
        public int Absent { get; set; }
        public int TotalSessions { get; set; }
    }

    [Parameter] public List<HorizontalBarItem> Items { get; set; } = new();
    [Parameter] public string TrendText { get; set; } = "Attendance tracked across active periods";
    [Parameter] public string FooterSummary { get; set; } = string.Empty;

    private string? _hoveredItemName;

    private string GetBarColorClass(double rate)
    {
        if (rate >= 80) return "bg-[#A6FA53]"; // Neo-Lime
        if (rate >= 60) return "bg-[#FFD026]"; // Neo-Yellow
        return "bg-[#FF6B6B]"; // Neo-Coral
    }
}
