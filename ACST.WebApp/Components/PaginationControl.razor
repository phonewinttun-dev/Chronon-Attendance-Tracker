<nav aria-label="Pagination Navigation" class="flex items-center justify-center gap-2 py-4 select-none">
    <!-- Previous Button -->
    <button type="button" 
            class="flex items-center px-3 py-1.5 text-xs font-mono font-bold transition-all rounded-lg border-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-black
                   @(HasPrevious ? "bg-card border-border text-foreground hover:bg-[#A6FA53] hover:text-black hover:border-black shadow-neo-sm cursor-pointer active:translate-x-0.5 active:translate-y-0.5" : "border-border/40 text-muted-foreground/40 cursor-not-allowed")"
            disabled="@(!HasPrevious)"
            aria-disabled="@(!HasPrevious)"
            aria-label="Go to previous page"
            @onclick="GoToPrevious">
        <!-- SVG Left Arrow -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" x2="5" y1="12" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Prev
    </button>

    <!-- Page Numbers -->
    @foreach (var pageNum in GetPageNumbers())
    {
        if (pageNum == null)
        {
            <span class="px-1 text-xs text-muted-foreground font-mono font-bold select-none" aria-hidden="true">...</span>
        }
        else
        {
            var p = pageNum.Value;
            var isActive = p == PageNumber;
            <button type="button"
                    class="w-8 h-8 flex items-center justify-center text-xs font-mono font-bold rounded-lg border-2 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-black
                           @(isActive 
                               ? "bg-[#FFD026] text-black border-black shadow-neo-sm font-black cursor-default" 
                               : "bg-card border-border text-foreground hover:bg-[#A6FA53] hover:text-black hover:border-black shadow-neo-sm cursor-pointer active:translate-x-0.5 active:translate-y-0.5")"
                    aria-label="Page @p"
                    aria-current="@(isActive ? "page" : null)"
                    @onclick="() => SelectPage(p)">
                @p
            </button>
        }
    }

    <!-- Next Button -->
    <button type="button" 
            class="flex items-center px-3 py-1.5 text-xs font-mono font-bold transition-all rounded-lg border-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-black
                   @(HasNext ? "bg-card border-border text-foreground hover:bg-[#A6FA53] hover:text-black hover:border-black shadow-neo-sm cursor-pointer active:translate-x-0.5 active:translate-y-0.5" : "border-border/40 text-muted-foreground/40 cursor-not-allowed")"
            disabled="@(!HasNext)"
            aria-disabled="@(!HasNext)"
            aria-label="Go to next page"
            @onclick="GoToNext">
        Next
        <!-- SVG Right Arrow -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
    </button>
</nav>

@code {
    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private bool HasPrevious => PageNumber > 1;
    private bool HasNext => PageNumber < TotalPages;

    private async Task SelectPage(int page)
    {
        if (page != PageNumber)
        {
            await PageChanged.InvokeAsync(page);
        }
    }

    private async Task GoToPrevious()
    {
        if (HasPrevious)
        {
            await PageChanged.InvokeAsync(PageNumber - 1);
        }
    }

    private async Task GoToNext()
    {
        if (HasNext)
        {
            await PageChanged.InvokeAsync(PageNumber + 1);
        }
    }

    private List<int?> GetPageNumbers()
    {
        var pages = new List<int?>();
        int total = TotalPages <= 0 ? 1 : TotalPages;
        int current = PageNumber;

        // If total pages is small, show all
        if (total <= 7)
        {
            for (int i = 1; i <= total; i++)
            {
                pages.Add(i);
            }
            return pages;
        }

        bool showLeftEllipsis = current > 3;
        bool showRightEllipsis = current < total - 2;

        if (!showLeftEllipsis && showRightEllipsis)
        {
            pages.Add(1);
            pages.Add(2);
            pages.Add(3);
            pages.Add(null);
            pages.Add(total - 1);
            pages.Add(total);
        }
        else if (showLeftEllipsis && !showRightEllipsis)
        {
            pages.Add(1);
            pages.Add(2);
            pages.Add(null);
            pages.Add(total - 2);
            pages.Add(total - 1);
            pages.Add(total);
        }
        else
        {
            pages.Add(1);
            pages.Add(null);
            pages.Add(current - 1);
            pages.Add(current);
            pages.Add(current + 1);
            pages.Add(null);
            pages.Add(total);
        }

        return pages;
    }
}
