@inject IJSRuntime JS

<div class="inline-flex items-center gap-1.5" role="group" aria-label="Theme and Display Settings">
    <!-- Light / Dark Mode Toggle -->
    <button @onclick="ToggleTheme" 
            class="relative p-2 rounded-lg bg-card hover:bg-[#FFD026] text-foreground hover:text-black transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary border-2 border-border shadow-neo-sm cursor-pointer active:translate-x-0.5 active:translate-y-0.5 inline-flex items-center justify-center"
            title="@(_isDark ? "Switch to Light Mode" : "Switch to Dark Mode")"
            aria-label="@(_isDark ? "Switch to Light Mode" : "Switch to Dark Mode")">
        @if (_isDark)
        {
            <!-- Sun Icon for Light Mode switch -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#FFD026] hover:text-black transition-colors" aria-hidden="true">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2"/>
                <path d="M12 20v2"/>
                <path d="m4.93 4.93 1.41 1.41"/>
                <path d="m17.66 17.66 1.41 1.41"/>
                <path d="M2 12h2"/>
                <path d="M20 12h2"/>
                <path d="m6.34 17.66-1.41 1.41"/>
                <path d="m19.07 4.93-1.41 1.41"/>
            </svg>
        }
        else
        {
            <!-- Moon Icon for Dark Mode switch -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-foreground transition-colors" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
        }
    </button>

    <!-- Night Light (Eye-Comfort) Toggle -->
    <button @onclick="ToggleNightLight"
            class="relative p-2 rounded-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary border-2 border-border shadow-neo-sm cursor-pointer active:translate-x-0.5 active:translate-y-0.5 inline-flex items-center justify-center @(_isNightLight ? "bg-[#A6FA53] text-black shadow-neo font-black" : "bg-card text-foreground hover:bg-[#FFD026] hover:text-black")"
            title="@(_isNightLight ? "Disable Eye-Comfort Night Light (Active)" : "Enable Eye-Comfort Night Light")"
            aria-label="@(_isNightLight ? "Disable Eye-Comfort Night Light (Active)" : "Enable Eye-Comfort Night Light")"
            aria-pressed="@_isNightLight">
        <!-- Low-blue-light / eye icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
        </svg>
    </button>
</div>

@code {
    private bool _isDark = true;
    private bool _isNightLight = false;
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
            try
            {
                var theme = await JS.InvokeAsync<string>("themeInterop.getTheme");
                _isDark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);

                _isNightLight = await JS.InvokeAsync<bool>("themeInterop.getNightLight");
                StateHasChanged();
            }
            catch
            {
                // Fallback safe default
            }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("themeInterop.toggleTheme");
            _isDark = string.Equals(newTheme, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _isDark = !_isDark;
        }
    }

    private async Task ToggleNightLight()
    {
        try
        {
            _isNightLight = await JS.InvokeAsync<bool>("themeInterop.toggleNightLight");
        }
        catch
        {
            _isNightLight = !_isNightLight;
        }
    }
}
