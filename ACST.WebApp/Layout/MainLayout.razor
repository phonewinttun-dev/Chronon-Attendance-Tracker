@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService AuthState
@inject NavigationManager Navigation

@{
    var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
    var isAuthPage = string.IsNullOrEmpty(relativePath) ||
                     relativePath.Equals("login", StringComparison.OrdinalIgnoreCase) ||
                     relativePath.Equals("register", StringComparison.OrdinalIgnoreCase);
}

@if (isAuthPage)
{
    <div class="min-h-screen bg-background text-foreground flex items-center justify-center p-4">
        @Body
    </div>
}
else
{
    <div class="flex flex-col md:flex-row min-h-screen bg-background text-foreground relative">
        <!-- Skip to main content link for accessibility -->
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-3 focus:bg-[#A6FA53] focus:text-black focus:font-bold focus:border-2 focus:border-black focus:shadow-neo focus:outline-none">
            Skip to main content
        </a>

        <!-- Mobile Header -->
        <header class="h-16 bg-card border-b-2 border-border flex items-center justify-between px-6 md:hidden shrink-0">
            <div class="flex items-center gap-3">
                <button @onclick="ToggleMobileMenu" class="p-1.5 rounded-lg border-2 border-border hover:bg-[#A6FA53] text-foreground hover:text-black transition-all shadow-neo-sm cursor-pointer focus:outline-none" aria-label="Toggle Menu" aria-expanded="@_isMobileMenuOpen">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                        <line x1="4" x2="20" y1="12" y2="12"/>
                        <line x1="4" x2="20" y1="6" y2="6"/>
                        <line x1="4" x2="20" y1="18" y2="18"/>
                    </svg>
                </button>
                <span class="font-black text-lg tracking-tight font-sans">Chronon Tracker</span>
            </div>
            <div class="flex items-center gap-2">
                <ThemeToggle />
                <NotificationBell />
            </div>
        </header>

        <!-- Mobile Drawer Backdrop -->
        @if (_isMobileMenuOpen)
        {
            <div class="fixed inset-0 bg-black/70 backdrop-blur-xs z-30 md:hidden" @onclick="ToggleMobileMenu" aria-hidden="true"></div>
        }

        <!-- Sidebar Navigation -->
        <nav class="@GetSidebarClass()" aria-label="Sidebar Navigation">
            <!-- Sidebar Header -->
            <div class="@GetSidebarHeaderClass()">
                <div class="@GetSidebarTitleClass()">
                    Chronon Tracker
                </div>
                <button @onclick="ToggleSidebar" class="hidden md:block p-1.5 rounded-lg border-2 border-border hover:bg-[#A6FA53] hover:text-black transition-all shadow-neo-sm focus:outline-none cursor-pointer" title="@(_isCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                    @if (_isCollapsed)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m14 15 3-3-3-3"/></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg>
                    }
                </button>
            </div>

            <!-- Navigation Links -->
            <div class="flex flex-col py-3 space-y-1.5">
                <NavLink class="@GetNavLinkClass()" href="dashboard" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Dashboard" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Dashboard
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="calendar" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Calendar" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Calendar
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="attendance" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Attendance" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Attendance
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="semesters" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Semesters" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 lucide lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/><path d="M21.5 12v6"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Semesters
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="modules" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Modules" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 lucide lucide-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Modules
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="holidays" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Holidays" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Holidays
                    </span>
                </NavLink>
                <NavLink class="@GetNavLinkClass()" href="sessions" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Sessions" : "")" @onclick="CloseMobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span class="@GetNavLinkTextClass()">
                        Sessions
                    </span>
                </NavLink>

                <!-- Admin-Only Navigation Link -->
                @if (AuthState.IsAdmin)
                {
                    <NavLink class="@GetNavLinkClass()" href="roles" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Roles" : "")" @onclick="CloseMobileMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span class="@GetNavLinkTextClass()">
                            Roles & Permissions
                        </span>
                    </NavLink>
                }

                <!-- Admin-Only Navigation Link -->
                @if (AuthState.IsAdmin)
                {
                    <NavLink class="@GetNavLinkClass()" href="users" ActiveClass="bg-[#A6FA53] text-black font-black border-2 border-black shadow-neo-sm" title="@(_isCollapsed ? "Users" : "")" @onclick="CloseMobileMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span class="@GetNavLinkTextClass()">
                            Users & Auth
                        </span>
                    </NavLink>
                }
            </div>

            <!-- Sidebar Footer / Sign Out -->
            @if (AuthState.IsLoggedIn)
            {
                <div class="mt-auto py-3 border-t-2 border-border">
                    <button class="@GetNavLinkClass() text-[#FF6B6B] hover:bg-[#FF6B6B] hover:text-black cursor-pointer"
                            @onclick="HandleLogout" title="Sign Out">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-5 h-5 shrink-0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span class="@GetNavLinkTextClass()">
                            Sign Out
                        </span>
                    </button>
                </div>
            }
        </nav>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <!-- Desktop Header Bar -->
            <header class="hidden md:flex h-16 bg-card border-b-2 border-border items-center justify-between px-8 shrink-0">
                <!-- Active Role Selector Toggle (Only for actual Admins) -->
                @if (AuthState.IsActualAdmin)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-muted-foreground font-mono font-bold uppercase">Mode:</span>
                        <div class="inline-flex p-1 rounded-lg bg-background border-2 border-border shadow-neo-sm text-xs">
                            <button class="px-3 py-1 rounded-md text-xs font-mono font-bold transition-all cursor-pointer flex items-center gap-1.5 @(AuthState.IsAdmin ? "bg-[#A6FA53] text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")"
                                    @onclick='() => ChangeRole("Admin")'>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                <span>Admin</span>
                            </button>
                            <button class="px-3 py-1 rounded-md text-xs font-mono font-bold transition-all cursor-pointer flex items-center gap-1.5 @(!AuthState.IsAdmin ? "bg-[#A6FA53] text-black border border-black shadow-neo-sm" : "text-muted-foreground hover:text-foreground")"
                                    @onclick='() => ChangeRole("User")'>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <span>User</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div></div>
                }

                <div class="flex items-center gap-3">
                    <ThemeToggle />
                    <NotificationBell />
                </div>
            </header>

            <!-- Main Content -->
            <main id="main-content" tabindex="-1" class="flex-1 p-4 md:p-8 overflow-y-auto max-w-7xl mx-auto w-full focus:outline-none">
                @Body
            </main>
        </div>
    </div>
}

@if (_showSignOutDialog)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center z-[100] animate-in fade-in duration-200" @onclick="() => _showSignOutDialog = false">
        <div class="bg-card border-2 border-black dark:border-zinc-700 rounded-2xl p-6 max-w-sm w-full shadow-neo-xl text-center animate-in zoom-in-95 duration-200" @onclick:stopPropagation="true">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-xl bg-[#FF6B6B] text-black border-2 border-black shadow-neo-sm mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-6 h-6"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </div>
            <h3 class="text-xl font-black text-foreground mb-1.5 font-sans">Sign Out</h3>
            <p class="text-xs text-muted-foreground mb-6 leading-relaxed font-mono">Are you sure you want to sign out of your account?</p>
            <div class="flex items-center gap-3">
                <button class="neo-btn-destructive flex-1 py-2.5 rounded-xl text-xs font-black shadow-neo"
                        @onclick="ConfirmLogout">
                    Sign Out
                </button>
                <button class="neo-btn flex-1 py-2.5 bg-card text-foreground border-2 border-border rounded-xl text-xs font-bold shadow-neo-sm"
                        @onclick="() => _showSignOutDialog = false">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload text-primary ml-2 hover:underline">Reload</a>
    <a class="dismiss cursor-pointer float-right mr-2 hover:text-destructive">×</a>
</div>

@code {
    private bool _isCollapsed = false;
    private bool _isMobileMenuOpen = false;
    private bool _initialized = false;
    private bool _showSignOutDialog = false;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await AuthState.InitializeAsync();
        _initialized = true;
        CheckAuthentication();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CheckAuthentication();
    }

    private void CheckAuthentication()
    {
        if (!_initialized) return;

        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var isAuthPage = string.IsNullOrEmpty(relativePath) ||
                         relativePath.Equals("login", StringComparison.OrdinalIgnoreCase) ||
                         relativePath.Equals("register", StringComparison.OrdinalIgnoreCase);

        if (!AuthState.IsLoggedIn && !isAuthPage)
        {
            Navigation.NavigateTo("login");
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task ChangeRole(string role)
    {
        await AuthState.SwitchRoleAsync(role);
    }

    private void HandleLogout()
    {
        _showSignOutDialog = true;
    }

    private async Task ConfirmLogout()
    {
        _showSignOutDialog = false;
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void ToggleSidebar()
    {
        _isCollapsed = !_isCollapsed;
    }

    private void ToggleMobileMenu()
    {
        _isMobileMenuOpen = !_isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _isMobileMenuOpen = false;
    }

    private string GetSidebarClass()
    {
        return "bg-card border-r-2 border-border flex flex-col shrink-0 transition-all duration-300 ease-in-out fixed inset-y-0 left-0 z-40 w-64 md:z-auto md:static md:translate-x-0 " + 
               (_isMobileMenuOpen ? "translate-x-0 shadow-neo-xl" : "-translate-x-full md:translate-x-0") + " " +
               (_isCollapsed ? "md:w-16" : "md:w-64");
    }

    private string GetSidebarHeaderClass()
    {
        return "h-16 flex items-center border-b-2 border-border transition-all duration-300 justify-between px-6 " +
               (_isCollapsed ? "md:justify-center md:px-0" : "md:justify-between md:px-6");
    }

    private string GetSidebarTitleClass()
    {
        return "font-black text-lg tracking-tight whitespace-nowrap transition-all duration-300 overflow-hidden font-sans " +
               (_isCollapsed ? "md:max-w-0 md:opacity-0 max-w-48 opacity-100" : "max-w-48 opacity-100");
    }

    private string GetNavLinkClass()
    {
        return "py-2 px-3 rounded-lg text-xs font-mono font-bold transition-all text-muted-foreground hover:bg-[#FFD026] hover:text-black hover:border-black flex items-center justify-start mx-3 gap-2.5 border-2 border-transparent cursor-pointer " +
               (_isCollapsed ? "md:px-0 md:justify-center md:mx-2 md:gap-0" : "md:px-3 md:justify-start md:mx-3 md:gap-2.5");
    }

    private string GetNavLinkTextClass()
    {
        return "whitespace-nowrap transition-all duration-300 overflow-hidden " +
               (_isCollapsed ? "md:max-w-0 md:opacity-0 max-w-48 opacity-100" : "max-w-48 opacity-100");
    }
}


